{
  "name": "quicktool",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/test-number-words.mjs && node scripts/run-unit-tests.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:e2e": "npm run build && npx playwright test --project=desktop --project=phone",
    "test:e2e:browsers": "npm run build && npx playwright test --project=iphone --project=firefox",
    "test:e2e:only": "npx playwright test",
    "build:css": "npx tailwindcss -i ./src/css/styles.css -o ./_site/css/styles.css --minify",
    "build": "npm run build:css && npx @11ty/eleventy",
    "serve": "npx @11ty/eleventy --serve",
    "debug": "DEBUG=* npx @11ty/eleventy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KiranYelisetti/quickTool.git"
  },
