  },
  "homepage": "https://github.com/KiranYelisetti/quickTool#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.23",
    "chart.js": "^4.6.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  }
