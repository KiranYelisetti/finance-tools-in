            <!-- Documents Required Section -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
                <div class="qt-note is-tip">
                    <h3 class="qt-h3 mb-4">Documents for Salaried</h3>
                    <ul class="space-y-3">
                        <li class="flex items-start"><span><strong>Identity Proof:</strong> Aadhar, PAN, Passport, Voters ID</span></li>
                        <li class="flex items-start"><span><strong>Address Proof:</strong> Utility Bill, Rent Agreement, Aadhar</span></li>
                        <li class="flex items-start"><span><strong>Income Proof:</strong> Last 3 months payslips, Form 16</span></li>
                        <li class="flex items-start"><span><strong>Bank Statement:</strong> Last 6 months salary account statement</span></li>
                    </ul>
                </div>
                <div class="qt-note is-tip">
                    <h3 class="qt-h3 mb-4">Documents for Self-Employed</h3>
                    <ul class="space-y-3">
                        <li class="flex items-start"><span><strong>Identity & Address:</strong> Same as salaried (Aadhar/PAN/etc)</span></li>
                        <li class="flex items-start"><span><strong>Income Proof:</strong> ITR for last 2 years, P&L Account, Balance Sheet</span></li>
                        <li class="flex items-start"><span><strong>Business Proof:</strong> Gumasta License, GST Registration, MOA</span></li>
                        <li class="flex items-start"><span><strong>Bank Statement:</strong> Last 6 months current account statement</span></li>
                    </ul>
                </div>
            </div>

            <!-- Fixed vs Floating Rate -->
            <div class="mb-12">
                <h3 class="qt-h3 mb-4">Fixed vs Floating Interest Rate: Which is Better?</h3>
                <div class="overflow-x-auto">
                    <div class="grid grid-cols-1 md:grid-cols-2">
                        <div class="p-6 border-dashed border-line-soft border-b-2">
                            <h4 class="font-bold mb-2">Floating Interest Rate</h4>
                            <p class="mb-4 text-sm">Linked to bank's repo rate (RLLR)</p>
                            <ul class="space-y-2 text-sm">
                                <li class="flex items-center">Currently cheaper (8.70% - 9.50%)</li>
                                <li class="flex items-center">No pre-payment penalty (for individuals)</li>
                                <li class="flex items-center">EMI can increase if repo rate rises</li>
                                <li class="flex items-center"><strong>Recommended</strong> for most borrowers</li>
                            </ul>
                        </div>
                        <div class="p-6">
                            <h4 class="font-bold mb-2">Fixed Interest Rate</h4>
                            <p class="mb-4 text-sm">Remains constant throughout tenure</p>
                            <ul class="space-y-2 text-sm">
                                <li class="flex items-center">Slightly higher rates (10% - 12%+)</li>
                                <li class="flex items-center">May have foreclosure charges</li>
                                <li class="flex items-center">Fixed EMI helps in budgeting</li>
                                <li class="flex items-center">Good if market rates are expected to rise steeply</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Factors Affecting EMI -->
            <div class="qt-note">
                <h3 class="qt-h3 mb-3">Factors that Affect Your Car Loan EMI</h3>
                <ul class="space-y-2">
                    <li><strong>1. Credit Score:</strong> 750+ score gets you 0.5-1% lower interest rate. A 800+ score can get you pre-approved offers at lowest market rates.</li>
                    <li><strong>2. Loan Tenure:</strong> Longer tenure (7 years) = Lower EMI but Higher Interest. Shorter tenure (3-4 years) = Higher EMI but huge interest savings.</li>
                    <li><strong>3. Down Payment:</strong> Higher down payment reduces loan amount and total interest outgo. Aim for at least 20%.</li>
                    <li><strong>4. Car Manufacturer:</strong> Banks often have tie-ups with manufacturers (Maruti, Hyundai, Tata) for special lower rates.</li>
                </ul>
            </div>
        </div>
