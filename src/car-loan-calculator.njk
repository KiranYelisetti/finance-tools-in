{% block scripts %}
<script src="/js/calc/car-loan.js"></script>
</main>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        initAutoSave('car_loan_calc');
        calculateCarLoan(false);
    });

    document.querySelectorAll('input[name="carType"]').forEach(radio => {
        radio.addEventListener('change', function () {
            const interestInput = document.getElementById('interestRate');
            if (this.value === 'new') {
                interestInput.value = '9.5';
                interestInput.min = '7.6';
                interestInput.max = '15';
            } else {
                interestInput.value = '13';
                interestInput.min = '12';
                interestInput.max = '20';

                trackEvent('feature_use', {
                    feature_name: 'car_type_used',
                    tool_name: 'Car Loan Calculator'
                });
            }
        });
    });

    function formatIndianCurrency(amount) {
        if (amount >= 10000000) {
            return '₹' + (amount / 10000000).toFixed(2) + ' Cr';
        } else if (amount >= 100000) {
            return '₹' + (amount / 100000).toFixed(2) + ' Lac';
        } else {
            return '₹' + amount.toLocaleString('en-IN');
        }
    }

    function calculateCarLoan(shouldScroll = true) {
        const carPrice = parseINR(document.getElementById('carPrice').value);
        const downPayment = parseINR(document.getElementById('downPayment').value);
        const annualRate = parseINR(document.getElementById('interestRate').value);
        const tenureYears = parseINR(document.getElementById('loanTenure').value);

        // Optional Costs
        const insurance = parseINR(document.getElementById('insurance').value) || 0;
        const rtoTaxPercent = parseINR(document.getElementById('rtoTax').value) || 0;
        const accessories = parseINR(document.getElementById('accessories').value) || 0;
        const otherCharges = parseINR(document.getElementById('otherCharges').value) || 0;

        // The sums live in /js/calc/car-loan.js (unit tested in tests/unit)
        const r = QTCalc.carLoan.calculate({ carPrice, downPayment, annualRate, tenureYears, insurance, rtoTaxPercent, accessories, otherCharges });

        // GA4 Event Tracking
        trackCalculatorUsage('Car Loan Calculator', r.loanAmount);

        // Display results
        document.getElementById('monthlyEMI').textContent = formatIndianCurrency(Math.round(r.emi));
        document.getElementById('onRoadPrice').textContent = formatIndianCurrency(Math.round(r.onRoadPrice));
        document.getElementById('loanAmount').textContent = formatIndianCurrency(Math.round(r.loanAmount));
        document.getElementById('totalInterest').textContent = formatIndianCurrency(Math.round(r.totalInterest));

        // On-road price breakdown
        document.getElementById('exShowroomPrice').textContent = formatIndianCurrency(carPrice);
        document.getElementById('rtoAmount').textContent = formatIndianCurrency(Math.round(r.rtoAmount));
        document.getElementById('insuranceAmount').textContent = formatIndianCurrency(insurance);
        document.getElementById('accessoriesAmount').textContent = formatIndianCurrency(accessories);
        document.getElementById('otherChargesAmount').textContent = formatIndianCurrency(otherCharges);
        document.getElementById('totalOnRoadPrice').textContent = formatIndianCurrency(Math.round(r.onRoadPrice));

        // Payment analysis
        document.getElementById('downPaymentDisplay').textContent = formatIndianCurrency(downPayment);
        document.getElementById('totalEMIPayments').textContent = formatIndianCurrency(Math.round(r.totalEMIPayments));
        document.getElementById('totalInterestDisplay').textContent = formatIndianCurrency(Math.round(r.totalInterest));
        document.getElementById('totalAmountPaid').textContent = formatIndianCurrency(Math.round(r.totalAmountPaid));
        document.getElementById('interestPercentage').textContent = r.interestPercentOfPrice.toFixed(1) + '%';

        // Loan details
        document.getElementById('totalMonths').textContent = r.tenureMonths + ' months';
        document.getElementById('downPaymentPercent').textContent = r.downPaymentPercent.toFixed(1) + '%';

        document.getElementById('results').classList.remove('hidden');
        if (shouldScroll) {
            document.getElementById('results').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }
</script>
{% endblock %}
