<main>
    <section class="qt-wrap pt-9 md:pt-16 pb-12 md:pb-20">
        <div class="grid gap-11 lg:grid-cols-12 lg:gap-12 items-center">
            <div class="lg:col-span-6">
                <div class="flex flex-wrap gap-3 mb-6">
                    <span class="qt-sticker">Made for India</span>
                    <span class="qt-sticker is-mehendi" style="--tilt: 2deg">FY 2026-27 rules</span>
                </div>
                <h1 class="qt-display">Paisa maths, <span class="qt-marker">sorted.</span></h1>
                <p class="qt-lede mt-6">Free calculators for loans, income tax, salary, savings and amounts in words, worked out the Indian way: lakh and crore, old and new regime, cheque wording. The sums run on your phone, so nothing you type is sent anywhere.</p>
                <div class="flex flex-wrap gap-3 mt-8">
                    <a href="/salary-calculator/" class="qt-btn qt-btn--lg">Find my in-hand salary</a>
                    <a href="/income-tax-calculator/" class="qt-btn qt-btn--secondary qt-btn--lg">Old or new regime?</a>
                </div>
            </div>

            <section class="lg:col-span-6 w-full" aria-labelledby="quick-words">
                <div class="qt-cheque">
                    <div class="qt-cheque-top">
                        <span id="quick-words">Cheque helper</span>
                        <span>Amount in words</span>
                    </div>
                    <label for="homeAmount" class="sr-only">Type an amount in figures, or in lakh and crore</label>
                    <div class="qt-affix is-prefix is-xl mt-4">
                        <span class="qt-affix-text" aria-hidden="true">₹</span>
                        <input id="homeAmount" type="text" value="15,00,000" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="80"
                            class="qt-input qt-input--xl" placeholder="15,00,000 or 1.5 crore" oninput="homeConvert()">
                    </div>
                    <div class="qt-cheque-line" aria-live="polite">
                        <span>Rupees</span>
                        <p class="qt-cheque-words"><span id="homeWords">Fifteen Lakh Rupees Only</span></p>
                    </div>
                    <div class="qt-cheque-foot">
                        <span class="qt-cheque-amount"><span id="homeFigure">₹15,00,000</span>/-</span>
                        <span class="qt-cheque-sign">Signature</span>
                    </div>
                    <p id="homeDigits" class="mt-3 text-sm font-semibold text-chai-700">₹15,00,000, or 1.5 million</p>
                    <p id="homeError" class="qt-error hidden"></p>
                    <div class="qt-chips mt-4" aria-label="Try an amount">
                        <button type="button" class="qt-chip" data-try="2,50,000">2,50,000</button>
                        <button type="button" class="qt-chip" data-try="1.5 crore">1.5 crore</button>
                        <button type="button" class="qt-chip" data-try="99,999.50">99,999.50</button>
                    </div>
                </div>
                <p class="mt-5 text-sm"><a id="homeMore" class="qt-link" href="/number-to-words/">Cheque wording and every format</a></p>
            </section>
        </div>
    </section>

    <div class="qt-ticker" aria-label="Indian number names">
        <div class="qt-ticker-track">
            {% set facts = [["1 lakh", "1,00,000"], ["10 lakh", "10,00,000"], ["1 crore", "1,00,00,000"], ["100 crore", "1 arab"], ["1 million", "10 lakh"], ["1 billion", "100 crore"], ["1 lakh crore", "1 trillion"], ["1,000", "1 hazaar"]] %}
            <ul class="qt-ticker-list">
                {% for f in facts %}<li><span><b>{{ f[0] }}</b> = {{ f[1] }}</span></li>{% endfor %}
            </ul>
            <ul class="qt-ticker-list" aria-hidden="true">
                {% for f in facts %}<li><span><b>{{ f[0] }}</b> = {{ f[1] }}</span></li>{% endfor %}
            </ul>
        </div>
    </div>

    <section class="qt-wrap qt-section" aria-labelledby="all-tools">
        <div class="qt-section-head">
            <div>
                <p class="qt-eyebrow mb-2">{{ tools | length }} groups, every tool free</p>
                <h2 id="all-tools" class="qt-h2">Pick a calculator</h2>
            </div>
            <div class="qt-seg" role="group" aria-label="Show tools for">
                <button type="button" aria-pressed="true" data-filter="all">All</button>
                {% for g in tools %}<button type="button" aria-pressed="false" data-filter="{{ g.key }}">{{ g.group | replace(" and ", " & ") }}</button>{% endfor %}
            </div>
        </div>

        <div class="qt-bento" id="toolGrid">
            
            {% for g in tools %}{% for t in g.tools %}
            {% set tile = homeTiles[t.url] or {} %}
            {% set changed = collections.all | lastChanged(t.url) %}
            <a href="{{ t.url }}" class="qt-tile qt-reveal is-{{ g.key }}{% if tile.size %} is-{{ tile.size }}{% endif %}" data-group="{{ g.key }}" style="--i: {{ loop.index0 }}">
                <span class="qt-eyebrow">{{ g.group }}</span>
                <span class="qt-tile-name">{{ t.name }}</span>
                <span class="qt-tile-desc">{{ t.desc }}</span>
                {% if tile.output %}
                <span class="qt-tile-sample"><span>{{ tile.input }}</span><b>{{ tile.output }}</b></span>
                {% elif changed %}
                <span class="qt-tile-date mt-auto">Updated {{ changed | humanDate }}</span>
                {% endif %}
                <span class="qt-tile-go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h9.5M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </a>
            {% endfor %}{% endfor %}
        </div>
    </section>

    <section class="qt-wrap qt-section">
        <div class="grid gap-8 lg:grid-cols-12 items-start">
            <div class="lg:col-span-5 qt-reveal from-left">
                <span class="qt-sticker is-rani">No guesswork</span>
                <h2 class="qt-h2 mt-4">Rules change. These pages keep up.</h2>
            </div>
            <div class="lg:col-span-7 qt-prose qt-reveal from-right">
                <p>Tax slabs, GST rates and small-savings interest rates change every year or every quarter, so a calculator is only as good as its last check. When a rule changes, the page that uses it is updated and the change is written down on the <a href="/updates/">updates page</a>, with the date.</p>
                <p>Where a page depends on a rule, it links to the body that sets it: the Income Tax Department, the GST Council, the Reserve Bank of India or the Ministry of Finance for small-savings rates. The figures here are for planning. Before you sign a loan or file a return, confirm the numbers with the lender or a tax professional.</p>
                <p>Found a figure that looks wrong? Write to <a href="mailto:quicktoolsindiaa@gmail.com">quicktoolsindiaa@gmail.com</a> and it will be checked.</p>
            </div>
        </div>
    </section>
</main>

{% block scripts %}
<script src="/js/number-words.js"></script>
<script>
    function homeConvert() {
        var value = document.getElementById('homeAmount').value;
        var r = NumberWords.convert(value);
        var err = document.getElementById('homeError');
        var words = document.getElementById('homeWords');
        var digits = document.getElementById('homeDigits');
        var figure = document.getElementById('homeFigure');
        var input = document.getElementById('homeAmount');
        if (r.empty || r.error) {
            err.textContent = r.error || '';
            err.classList.toggle('hidden', !r.error);
            input.setAttribute('aria-invalid', r.error ? 'true' : 'false');
            words.parentElement.style.opacity = '.35';
            return;
        }
        err.classList.add('hidden');
        input.setAttribute('aria-invalid', 'false');
        words.parentElement.style.opacity = '';
        figure.textContent = '₹' + r.indianGrouped;
        // Digits typed: show the words. Lakh or crore typed: show the digits.
        if (r.hasUnits) {
            words.textContent = '₹' + r.indianGrouped;
            digits.textContent = r.inWords;
        } else {
            words.textContent = r.inWords;
            digits.textContent = '₹' + r.indianGrouped + ', or ' + r.internationalFormat.toLowerCase();
        }
        words.classList.remove('qt-fresh');
        void words.offsetWidth;
        words.classList.add('qt-fresh');
        document.getElementById('homeMore').href = '/number-to-words/?n=' + encodeURIComponent(value.trim());
    }
    homeConvert();

    // Example chips fill the cheque
    document.querySelectorAll('[data-try]').forEach(function (b) {
        b.addEventListener('click', function () {
            var input = document.getElementById('homeAmount');
            input.value = b.getAttribute('data-try');
            homeConvert();
            input.focus();
        });
    });

    // Group filter for the tool tiles
    (function () {
        var grid = document.getElementById('toolGrid');
        var buttons = document.querySelectorAll('[data-filter]');
        buttons.forEach(function (b) {
            b.addEventListener('click', function () {
                var f = b.getAttribute('data-filter');
                buttons.forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
                grid.classList.toggle('is-filtered', f !== 'all');
                grid.querySelectorAll('.qt-tile').forEach(function (t) {
                    t.hidden = f !== 'all' && t.getAttribute('data-group') !== f;
                    if (!t.hidden) t.classList.add('is-in');
                });
            });
        });
    })();
</script>
{% endblock %}
