{% block scripts %}
<script src="/js/calc/ssy.js"></script>
<script>
    // Input Synchronization
    function syncInput(inputId, sliderId, event) {
        const input = document.getElementById(inputId);
        const slider = document.getElementById(sliderId);

        if (event && event.target === slider) {
            input.value = input.classList.contains('format-inr')
                ? formatIndianNumber(slider.value)
                : slider.value;
        } else {
            slider.value = parseINR(input.value);
        }

        validateAndCalculate();
    }

    // Format Indian Currency
    function formatIndianCurrency(num) {
        const value = parseFloat(num);
        if (value >= 10000000) {
            return '₹' + (value / 10000000).toFixed(2) + ' Cr';
        } else if (value >= 100000) {
            return '₹' + (value / 100000).toFixed(2) + ' Lac';
        } else {
            return '₹' + value.toLocaleString('en-IN', { maximumFractionDigits: 0 });
        }
    }

    // Load Preset
    function loadPreset(type) {
        const presets = {
            'small': { age: 5, deposit: 50000, rate: 8.2 },
            'medium': { age: 5, deposit: 100000, rate: 8.2 },
            'maximum': { age: 5, deposit: 150000, rate: 8.2 }
        };

        const preset = presets[type];
        document.getElementById('currentAge').value = preset.age;
        document.getElementById('annualDeposit').value = formatIndianNumber(preset.deposit);
        document.getElementById('annualDepositSlider').value = preset.deposit;
        document.getElementById('interestRate').value = preset.rate;
        document.getElementById('interestRateSlider').value = preset.rate;

        validateAndCalculate();
    }

    // Validate and Calculate
    function validateAndCalculate() {
        const currentAgeStr = document.getElementById('currentAge').value.trim();
        const annualDepositStr = document.getElementById('annualDeposit').value.trim();
        const interestRateStr = document.getElementById('interestRate').value.trim();

        if (currentAgeStr === '' || annualDepositStr === '' || interestRateStr === '') {
            return;
        }

        const currentAge = parseINR(currentAgeStr);
        const annualDeposit = parseINR(annualDepositStr);

        // The sums and the range checks live in /js/calc/ssy.js (unit tested in tests/unit)
        const r = QTCalc.ssy.calculate(currentAge, annualDeposit, parseINR(interestRateStr));
        if (!r) return;
        showSSY(currentAge, annualDeposit, r);
    }

    function showSSY(currentAge, annualDeposit, r) {
        // GA4 Event Tracking
        trackCalculatorUsage('SSY Calculator', annualDeposit);

        // Display Results
        document.getElementById('maturityValue').textContent = formatIndianCurrency(r.maturityValue);
        document.getElementById('totalInvestment').textContent = formatIndianCurrency(r.totalInvestment);
        document.getElementById('totalInterest').textContent = formatIndianCurrency(r.totalInterest);
        document.getElementById('taxBenefit').textContent = formatIndianCurrency(r.taxBenefit);
        document.getElementById('taxSavings').textContent = formatIndianCurrency(r.taxSavings).replace('₹', '');
        document.getElementById('partialWithdrawal').textContent = formatIndianCurrency(r.partialWithdrawal);

        // Breakdown
        document.getElementById('breakdown').innerHTML = `
            With an annual deposit of <strong>${formatIndianCurrency(annualDeposit)}</strong> for 15 years
            (from age ${currentAge} to ${r.depositEndAge}), your daughter's SSY account will have
            <strong>${formatIndianCurrency(r.maturityValue)}</strong> when she turns ${r.maturityAge}.
            This includes <strong>${formatIndianCurrency(r.totalInterest)}</strong> in tax-free interest earnings.
            At age 18, she can withdraw up to <strong>${formatIndianCurrency(r.partialWithdrawal)}</strong>
            for higher education expenses.
        `;

        // Show results
        document.getElementById('results').classList.remove('hidden');
        document.getElementById('placeholder').classList.add('hidden');
    }

    // Initialize with default values
    window.addEventListener('load', function () {
        initAutoSave('ssy_calc');
        validateAndCalculate();

        // Add blur change listeners for validation alerts
        document.getElementById('currentAge').addEventListener('change', (e) => {
            const val = parseInt(e.target.value);
            if (isNaN(val) || val < 0 || val > 10) {
                alert('Girl child must be under 10 years old to open SSY account');
                e.target.value = isNaN(val) ? 0 : Math.min(10, Math.max(0, val));
                validateAndCalculate();
            }
        });

        document.getElementById('annualDeposit').addEventListener('change', (e) => {
            const val = parseINR(e.target.value);
            if (val < 250 || val > 150000) {
                alert('Annual deposit must be between ₹250 and ₹1,50,000');
                e.target.value = formatIndianNumber(Math.min(150000, Math.max(250, val)));
                validateAndCalculate();
            }
        });
    });
</script>
{% endblock %}
