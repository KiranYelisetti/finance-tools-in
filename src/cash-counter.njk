                    <p class="mt-3 text-sm">Counts are saved only in your own browser so they survive a page refresh. Nothing is sent to a server, and Reset All clears the saved values.</p>
                </details>
                <details class="qt-faq-item">
                    <summary>
                        Can I use this counter to fill a bank deposit slip?
                                            </summary>
                    <p class="mt-3 text-sm">Yes. Pay-in slips ask for the number of notes of each denomination. Enter the same counts here to check the total before you write it on the slip.</p>
                </details>
            </div>
        </div>
    </div>
</main>

{% block scripts %}
<script src="/js/number-words.js"></script>
<script src="/js/calc/cash-counter.js"></script>
<script>
    function formatIndianCurrency(num) {
        return '₹' + parseFloat(num).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    }

    function calculateTotal() {
        // The denominations, limits and sums live in /js/calc/cash-counter.js (unit tested in tests/unit)
        const cash = QTCalc.cashCounter;
        const counts = {};
        for (const id of Object.keys(cash.DENOMINATIONS)) {
            const el = document.getElementById(id);
            const c = cash.clampCount(el.value);
            // Limit invalid or excessive inputs
            if (c.changed) el.value = c.count;
            counts[id] = c.count;
        }
        const total = cash.total(counts);

        document.getElementById('totalAmount').textContent = formatIndianCurrency(total);
        document.getElementById('totalInWords').textContent = total > 0 ? cash.numberToWords(total) : '';
    }



    // Calculate on page load
    window.addEventListener('load', function () {
        initAutoSave('cash_counter');
        calculateTotal();
    });
</script>
{% endblock %}
