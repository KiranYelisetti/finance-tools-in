{% block scripts %}
<script src="/js/vendor/pdf-lib-1.17.1.min.js"></script>
<script src="/js/calc/pdf-tools.js"></script>
<script>
(function () {
    var PT = QTCalc.pdfTools;
    var files = []; // { name, size, doc, pages }
    var $ = function (id) { return document.getElementById(id); };
    var list = $('pdfList'), status = $('pdfStatus'), errorBox = $('fileErrors');
    var kb = function (n) { return n >= 1048576 ? (n / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(n / 1024)) + ' KB'; };
    var fmt = function (n) { return Number(n).toLocaleString('en-IN'); };
    var REASONS = {
        encrypted: 'is password protected. Open it with its password, use Print and Save as PDF to make an unlocked copy, and add that.',
        broken: 'could not be read. It may be damaged or only partly downloaded.',
        'not-pdf': 'is not a PDF file.',
        empty: 'has no pages.'
    };

    function render() {
        list.textContent = '';
        files.forEach(function (f, i) {
            var li = document.createElement('li');
            li.className = 'qt-panel flex items-center gap-3 p-3';
            li.draggable = true;
            li.dataset.index = String(i);
            li.innerHTML = '<span class="qt-row-key w-6 text-center"></span>' +
                '<span class="min-w-0 flex-1"><span class="block font-semibold break-all"></span><span class="block qt-hint mt-0"></span></span>' +
                '<span class="flex gap-1 shrink-0"></span>';
            li.children[0].textContent = String(i + 1);
            li.children[1].children[0].textContent = f.name;
            li.children[1].children[1].textContent = fmt(f.pages) + (f.pages === 1 ? ' page, ' : ' pages, ') + kb(f.size);
            [['up', '↑', 'Move ' + f.name + ' up', i === 0], ['down', '↓', 'Move ' + f.name + ' down', i === files.length - 1], ['remove', '×', 'Remove ' + f.name, false]].forEach(function (b) {
                var el = document.createElement('button');
                el.type = 'button';
                el.className = 'qt-btn qt-btn--secondary qt-btn--sm';
                el.textContent = b[1];
                el.setAttribute('aria-label', b[2]);
                el.disabled = b[3];
                el.dataset.act = b[0];
                li.children[2].appendChild(el);
            });
            list.appendChild(li);
        });
        var pages = files.reduce(function (s, f) { return s + f.pages; }, 0);
        var size = files.reduce(function (s, f) { return s + f.size; }, 0);
        $('fileCount').textContent = String(files.length);
        $('summaryFiles').textContent = fmt(files.length);
        $('totalPages').textContent = fmt(pages);
        $('totalSize').textContent = kb(size);
        $('emptyList').hidden = files.length > 0;
        $('mergePdf').disabled = files.length < 2;
        $('clearFiles').disabled = files.length === 0;
        status.textContent = files.length < 2 ? (files.length ? 'Add one more PDF to merge.' : 'Add two or more PDF files.') : 'Ready to merge ' + files.length + ' files into ' + fmt(pages) + ' pages.';
    }

    async function add(fileList) {
        var problems = [];
        var incoming = Array.prototype.slice.call(fileList);
        for (var i = 0; i < incoming.length; i++) {
            var f = incoming[i];
            status.textContent = 'Reading ' + f.name + '...';
            var opened = await PT.openPdf(PDFLib, new Uint8Array(await f.arrayBuffer()));
            if (opened.ok) files.push({ name: f.name, size: f.size, doc: opened.doc, pages: opened.pages });
            else problems.push({ name: f.name, kind: opened.kind });
        }
        errorBox.textContent = '';
        problems.forEach(function (p) {
            var line = document.createElement('p');
            var strong = document.createElement('strong');
            strong.textContent = p.name;
            line.appendChild(strong);
            line.appendChild(document.createTextNode(' ' + REASONS[p.kind] + ' It was left out.'));
            errorBox.appendChild(line);
        });
        errorBox.hidden = problems.length === 0;
        render();
    }

    list.addEventListener('click', function (ev) {
        var b = ev.target.closest('button[data-act]');
        if (!b) return;
        var i = Number(b.closest('li').dataset.index);
        if (b.dataset.act === 'up') files = PT.move(files, i, i - 1);
        else if (b.dataset.act === 'down') files = PT.move(files, i, i + 1);
        else files.splice(i, 1);
        render();
        var again = list.querySelector('li[data-index="' + Math.min(b.dataset.act === 'up' ? i - 1 : b.dataset.act === 'down' ? i + 1 : i, files.length - 1) + '"] button[data-act="' + b.dataset.act + '"]');
        if (again && !again.disabled) again.focus();
    });

    var dragFrom = null;
    list.addEventListener('dragstart', function (ev) { var li = ev.target.closest('li'); if (li) { dragFrom = Number(li.dataset.index); ev.dataTransfer.effectAllowed = 'move'; } });
    list.addEventListener('dragover', function (ev) { if (dragFrom !== null) ev.preventDefault(); });
    list.addEventListener('drop', function (ev) {
        var li = ev.target.closest('li');
        if (dragFrom === null || !li) return;
        ev.preventDefault();
        files = PT.move(files, dragFrom, Number(li.dataset.index));
        dragFrom = null;
        render();
    });
    list.addEventListener('dragend', function () { dragFrom = null; });

    var zone = $('dropZone');
    zone.addEventListener('dragover', function (ev) { if (ev.dataTransfer && Array.prototype.indexOf.call(ev.dataTransfer.types, 'Files') >= 0) ev.preventDefault(); });
    zone.addEventListener('drop', function (ev) { if (ev.dataTransfer && ev.dataTransfer.files.length) { ev.preventDefault(); add(ev.dataTransfer.files); } });
    $('pdfInput').addEventListener('change', function (ev) { var fl = ev.target.files; add(fl).then(function () { ev.target.value = ''; }); });
    $('clearFiles').addEventListener('click', function () { files = []; errorBox.hidden = true; render(); });

    $('mergePdf').addEventListener('click', async function () {
        var btn = this;
        btn.disabled = true;
        try {
            var bytes = await PT.mergeDocs(PDFLib, files.map(function (f) { return f.doc; }), function (done, total) { status.textContent = 'Joining file ' + done + ' of ' + total + '...'; });
            var a = document.createElement('a');
            a.href = URL.createObjectURL(new Blob([bytes], { type: 'application/pdf' }));
            a.download = 'merged.pdf';
            document.body.appendChild(a);
            a.click();
            setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
            var pages = files.reduce(function (s, f) { return s + f.pages; }, 0);
            status.textContent = 'Done: ' + fmt(pages) + ' pages, ' + kb(bytes.length) + '. Check your downloads.';
        } catch (e) {
            errorBox.hidden = false;
            errorBox.textContent = 'Something went wrong while joining the files. Try merging fewer at a time.';
            status.textContent = 'The PDF was not made.';
        } finally {
            btn.disabled = files.length < 2;
        }
    });
    render();
})();
</script>
{% endblock %}
