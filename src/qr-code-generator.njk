{% block scripts %}
<script src="/js/vendor/qrcode-generator-1.4.4.js"></script>
<script src="/js/calc/qr-payload.js"></script>
<script>
(function () {
    var QP = QTCalc.qrPayload;
    qrcode.stringToBytes = qrcode.stringToBytesFuncs['UTF-8'];
    var type = 'url';
    var current = null; // { qr, payload }
    var $ = function (id) { return document.getElementById(id); };
    var preview = $('qrPreview'), message = $('qrMessage'), payloadBox = $('qrPayload');
    var MARGIN = 4;

    function fields() {
        switch (type) {
            case 'url': return { url: $('qrUrl').value };
            case 'text': return { text: $('qrText').value };
            case 'wifi': return { ssid: $('wifiSsid').value, security: $('wifiSecurity').value, password: $('wifiPassword').value, hidden: $('wifiHidden').checked };
            case 'upi': return { upiId: $('upiId').value, name: $('upiName').value, amount: $('upiAmount').value, note: $('upiNote').value };
            case 'phone': return { phone: $('qrPhone').value };
            case 'email': return { email: $('qrEmail').value, subject: $('qrSubject').value, body: $('qrBody').value };
        }
        return {};
    }

    function showErrors(field, text, show) {
        document.querySelectorAll('[data-error-for]').forEach(function (el) {
            var mine = show && el.getAttribute('data-error-for') === field && el.closest('[data-fields]').getAttribute('data-fields') === type;
            el.hidden = !mine;
            el.textContent = mine ? text : '';
        });
    }

    function setEmpty(text) {
        current = null;
        preview.innerHTML = '';
        message.textContent = text;
        payloadBox.textContent = '';
        $('downloadPng').disabled = true;
        $('downloadSvg').disabled = true;
    }

    function render() {
        var f = fields();
        var res = QP.build(type, f);
        if (!res.ok) {
            // Say what is missing, but do not shout at an empty form
            var empty = Object.keys(f).every(function (k) { return f[k] === '' || f[k] === false || k === 'security'; });
            showErrors(res.field, res.error, !empty);
            setEmpty(empty ? 'Fill in the fields and your code appears here.' : res.error);
            return;
        }
        showErrors(null, '', false);
        var qr = qrcode(0, $('qrLevel').value);
        try {
            qr.addData(res.payload, 'Byte');
            qr.make();
        } catch (e) {
            setEmpty('Too long for a QR code at this error correction level. Shorten it, or choose Low.');
            return;
        }
        current = { qr: qr, payload: res.payload };
        preview.innerHTML = QP.toSvg(qr.getModuleCount(), qr.isDark.bind(qr), MARGIN);
        var svg = preview.firstChild;
        svg.setAttribute('width', '100%');
        svg.setAttribute('height', '100%');
        svg.setAttribute('aria-hidden', 'true');
        message.textContent = 'Scan it with your phone to check before you share it.';
        payloadBox.textContent = res.payload;
        $('downloadPng').disabled = false;
        $('downloadSvg').disabled = false;
    }

    var queued = false;
    function schedule() {
        if (queued) return;
        queued = true;
        requestAnimationFrame(function () { queued = false; render(); });
    }

    function save(blob, name) {
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = name;
        document.body.appendChild(a);
        a.click();
        setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
    }

    /** Draw the current code on a canvas with whole pixels per module, close to the chosen size. */
    function drawCanvas() {
        var n = current.qr.getModuleCount(), total = n + 2 * MARGIN;
        var want = Number($('qrSize').value) || 512;
        var scale = Math.max(1, Math.round(want / total));
        var canvas = document.createElement('canvas');
        canvas.width = canvas.height = total * scale;
        var ctx = canvas.getContext('2d');
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#000000';
        for (var r = 0; r < n; r++) for (var c = 0; c < n; c++) {
            if (current.qr.isDark(r, c)) ctx.fillRect((c + MARGIN) * scale, (r + MARGIN) * scale, scale, scale);
        }
        return canvas;
    }
    window.__qrCanvas = function () { return current ? drawCanvas() : null; }; // used by the browser tests

    $('downloadPng').addEventListener('click', function () {
        if (!current) return;
        drawCanvas().toBlob(function (b) { save(b, 'qr-code-' + type + '.png'); }, 'image/png');
    });
    $('downloadSvg').addEventListener('click', function () {
        if (!current) return;
        var px = Number($('qrSize').value) || 512;
        save(new Blob([QP.toSvg(current.qr.getModuleCount(), current.qr.isDark.bind(current.qr), MARGIN, px)], { type: 'image/svg+xml' }), 'qr-code-' + type + '.svg');
    });

    $('qrType').addEventListener('click', function (ev) {
        var b = ev.target.closest('button[data-type]');
        if (!b) return;
        type = b.getAttribute('data-type');
        document.querySelectorAll('#qrType button').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
        document.querySelectorAll('[data-fields]').forEach(function (g) { g.hidden = g.getAttribute('data-fields') !== type; });
        render();
    });
    document.querySelectorAll('[data-fields] input, [data-fields] textarea, [data-fields] select, #qrLevel, #qrSize').forEach(function (el) {
        el.addEventListener('input', schedule);
        el.addEventListener('change', schedule);
    });
    render();
})();
</script>
{% endblock %}
