---
layout: base.njk
noIconFont: true
title: Blog & Financial Guides | QuickTools India
meta_title: Personal Finance Blog & Guides | QuickTools India
meta_description: "Read our guides on personal finance, loans, SIPs, and taxes in India. Plain-language explainers and money-saving strategies for everyday financial decisions."
---

<main class="qt-wrap">
    <section class="qt-toolhead">
        <nav class="qt-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Guides</span></nav>
        <div class="flex flex-wrap gap-3 mt-5">
            <span class="qt-sticker is-rani">Guides</span>
            <span class="qt-stamp">{{ collections.post | length }} guides</span>
        </div>
        <h1 class="qt-h1 mt-4 max-w-[18ch]">Financial Guides &amp; Articles</h1>
        <p class="qt-lede mt-4">Plain-language guides to saving money, understanding taxes, and planning investments in India.</p>
    </section>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mt-4">
        {%- for post in collections.post | reverse -%}
        {% set key = "amounts" %}
        {% for tag in post.data.tags %}{% if tag != "post" and key == "amounts" %}{% set key = tag | tagKey %}{% endif %}{% endfor %}
        <a href="{{ post.url }}" class="qt-tile is-{{ key }} qt-reveal" style="--i: {{ loop.index0 % 3 }}">
            <span class="flex flex-wrap gap-1.5">
                {% for tag in post.data.tags %}{% if tag != "post" and loop.index <= 3 %}<span class="qt-eyebrow">{{ tag }}{% if not loop.last %} ·{% endif %}</span>{% endif %}{% endfor %}
            </span>
            <span class="qt-tile-name">{{ post.data.title }}</span>
            <span class="qt-tile-desc">{{ post.data.meta_description }}</span>
            <span class="qt-tile-date mt-auto">{{ post.date | humanDate }}{% if post.data.readTime %} · {{ post.data.readTime }} min read{% endif %}</span>
            <span class="qt-tile-go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h9.5M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        {%- endfor -%}
    </div>
</main>
