{% block scripts %}
<script src="/js/calc/word-count.js"></script>
<script>
(function () {
    var WC = QTCalc.wordCount;
    var box = document.getElementById('text');
    var readWpm = document.getElementById('readWpm');
    var speakWpm = document.getElementById('speakWpm');
    var skipCommon = document.getElementById('skipCommon');
    var limitsBox = document.getElementById('limits');
    var smsRow = document.getElementById('smsInfo').parentNode;
    var fmt = function (n) { return Number(n).toLocaleString('en-IN'); };
    var pace = function (input, fallback) {
        var v = Math.round(Number(input.value));
        return v >= 50 && v <= 1500 ? v : fallback;
    };
    var last = null;

    // Settings are remembered on this device. The text itself never is.
    try {
        var saved = JSON.parse(localStorage.getItem('qt_word_counter') || '{}');
        if (saved.readWpm) readWpm.value = saved.readWpm;
        if (saved.speakWpm) speakWpm.value = saved.speakWpm;
        if (typeof saved.skipCommon === 'boolean') skipCommon.checked = saved.skipCommon;
    } catch (e) { /* private mode */ }
    function saveSettings() {
        try { localStorage.setItem('qt_word_counter', JSON.stringify({ readWpm: readWpm.value, speakWpm: speakWpm.value, skipCommon: skipCommon.checked })); } catch (e) { /* ignore */ }
    }

    // Build the limit rows once
    var limitRows = {};
    WC.LIMITS.forEach(function (l) {
        var row = document.createElement('div');
        row.className = 'qt-row';
        row.innerHTML = '<span class="qt-row-key"></span><span class="qt-row-val"></span>';
        row.firstChild.textContent = l.label + (l.soft ? ', about ' : ', ') + fmt(l.max);
        row.lastChild.id = 'limit-' + l.key;
        limitsBox.insertBefore(row, smsRow.parentNode === limitsBox ? smsRow : null);
        limitRows[l.key] = row.lastChild;
    });

    function render() {
        var a = WC.analyse(box.value, { readWpm: pace(readWpm, WC.READ_WPM), speakWpm: pace(speakWpm, WC.SPEAK_WPM), skipCommon: skipCommon.checked, top: 10 });
        last = a;
        document.getElementById('words').textContent = fmt(a.words);
        document.getElementById('characters').textContent = fmt(a.characters);
        document.getElementById('charactersNoSpaces').textContent = fmt(a.charactersNoSpaces);
        document.getElementById('sentences').textContent = fmt(a.sentences);
        document.getElementById('paragraphs').textContent = fmt(a.paragraphs);
        document.getElementById('readingTime').textContent = a.reading.text;
        document.getElementById('speakingTime').textContent = a.speaking.text;
        document.getElementById('avgWordLength').textContent = a.averageWordLength + ' characters';

        a.limits.forEach(function (l) {
            var el = limitRows[l.key];
            el.textContent = fmt(l.used) + ' of ' + fmt(l.max) + ', ' + (l.over ? fmt(-l.left) + ' over' : fmt(l.left) + ' left');
            el.classList.toggle('text-danger', l.over);
        });
        var s = a.sms;
        document.getElementById('smsInfo').textContent = s.parts === 0 ? '0 messages'
            : s.parts + (s.parts === 1 ? ' message' : ' messages') + ', ' + (s.encoding === 'GSM-7' ? 'standard text, ' : 'Unicode, ') + s.perPart + ' characters per ' + (s.parts === 1 ? 'message' : 'part');

        var tbody = document.getElementById('topWords');
        tbody.textContent = '';
        a.top.forEach(function (t) {
            var tr = document.createElement('tr');
            var td1 = document.createElement('td'); td1.textContent = t.word;
            var td2 = document.createElement('td'); td2.className = 'num'; td2.textContent = fmt(t.count);
            var td3 = document.createElement('td'); td3.className = 'num'; td3.textContent = (t.share * 100).toFixed(1) + '%';
            tr.appendChild(td1); tr.appendChild(td2); tr.appendChild(td3);
            tbody.appendChild(tr);
        });
        document.getElementById('topWrap').hidden = a.top.length === 0;
        document.getElementById('topEmpty').hidden = a.top.length > 0;
    }

    // One count per frame, so pasting a long text or holding a key down stays smooth
    var queued = false;
    function schedule() {
        if (queued) return;
        queued = true;
        requestAnimationFrame(function () { queued = false; render(); });
    }

    box.addEventListener('input', schedule);
    [readWpm, speakWpm].forEach(function (el) { el.addEventListener('input', function () { saveSettings(); schedule(); }); });
    skipCommon.addEventListener('change', function () { saveSettings(); render(); });
    document.getElementById('clearText').addEventListener('click', function () { box.value = ''; render(); box.focus(); });
    document.getElementById('copyStats').addEventListener('click', function (ev) {
        if (!last) render();
        var a = last;
        var lines = ['Words: ' + fmt(a.words), 'Characters: ' + fmt(a.characters), 'Characters without spaces: ' + fmt(a.charactersNoSpaces),
            'Sentences: ' + fmt(a.sentences), 'Paragraphs: ' + fmt(a.paragraphs), 'Reading time: ' + a.reading.text, 'Speaking time: ' + a.speaking.text];
        if (window.qt && qt.copy) qt.copy(lines.join('\n'), ev.currentTarget);
        else if (navigator.clipboard) navigator.clipboard.writeText(lines.join('\n'));
    });
    render();
})();
</script>
{% endblock %}
