{% block scripts %}
<script src="/js/calc/gratuity.js"></script>
<script>
    (function () {
        const G = QTCalc.gratuity;
        const $ = (id) => document.getElementById(id);
        const inr = (x) => '₹' + Math.round(x).toLocaleString('en-IN');
        const plural = (n, word) => n + ' ' + word + (n === 1 ? '' : 's');
        const LAW = { code: 'Code on Social Security, 2020', act1972: 'Payment of Gratuity Act, 1972' };

        function serviceText(s) {
            return plural(s.years, 'year') + ', ' + plural(s.months, 'month') + ', ' + plural(s.days, 'day');
        }

        function showError(message) {
            $('formError').textContent = message;
            $('formError').classList.remove('hidden');
            $('results').classList.add('hidden');
        }

        function notesFor(r, type, reason) {
            const notes = [];
            if (r.law === 'act1972') notes.push('You left before 21 November 2025, so the 1972 Act applies and wages mean basic pay plus DA only.');
            if (type === 'fixedTerm' && r.law === 'code') notes.push('Fixed-term staff qualify after one year under the contract. A further part of more than six months counts as one more year.');
            if (type === 'fixedTerm' && r.law === 'act1972') notes.push('Before 21 November 2025, fixed-term staff also needed five years.');
            if (reason === 'death' || reason === 'disablement') notes.push('No minimum service applies here. Part years of six months or less are not counted in this estimate.');
            if (reason === 'death') notes.push('The Code says a deceased employee\'s gratuity is paid pro rata, and we found no official worked example, so the employer\'s figure may differ.');
            if (r.taxable > 0) notes.push('The taxable part is added to your salary income for the year you receive it.');
            return notes;
        }

        function calculate(track) {
            $('formError').classList.add('hidden');
            const joinDate = $('joinDate').value;
            const lastDay = $('lastDay').value;
            const basicDA = parseINR($('basicDA').value);
            const type = $('empType').value;
            const reason = $('exitReason').value;
            if (!joinDate || !lastDay) return showError('Enter both the joining date and the last working day.');
            if (lastDay < joinDate) return showError('The last working day must be after the joining date.');
            if (!(basicDA > 0)) return showError('Enter your monthly basic pay plus DA.');

            const r = G.calculate({ joinDate, lastDay, basicDA, otherPay: parseINR($('otherPay').value), type, reason });
            if (!r) return showError('Check the dates and the pay you entered.');

            $('payable').textContent = inr(r.payable);
            if (!r.eligible) {
                $('verdict').textContent = 'Not due yet. This needs ' + plural(r.minYears, 'year') + ' of continuous service, and you have ' + plural(r.service.years, 'completed year') + '.';
            } else if (r.capped) {
                $('verdict').textContent = 'The formula gives ' + inr(r.formula) + ', so the ' + inr(r.cap) + ' ceiling applies. Your employer can pay more by agreement.';
            } else {
                $('verdict').textContent = 'Due for ' + plural(r.service.counted, 'year') + ' of service.';
            }
            $('taxFree').textContent = inr(r.taxFree);
            $('taxable').textContent = inr(r.taxable);
            $('lawUsed').textContent = LAW[r.law];
            $('serviceText').textContent = serviceText(r.service);
            $('yearsCounted').textContent = String(r.service.counted);
            $('wageUsed').textContent = inr(r.monthlyWage);
            $('halfRule').textContent = inr(r.addedByHalfRule);
            $('formulaAmount').textContent = inr(r.formula);
            $('capAmount').textContent = inr(r.cap);

            const oldAmount = Math.min(r.oldRuleFormula, r.cap);
            const extra = r.payable - oldAmount;
            const showCompare = r.eligible && r.law === 'code' && extra > 0;
            $('compareWrap').classList.toggle('hidden', !showCompare);
            if (showCompare) {
                $('oldAmount').textContent = inr(oldAmount);
                $('extraAmount').textContent = inr(extra);
            }

            const list = $('notes');
            list.textContent = '';
            notesFor(r, type, reason).forEach((text) => {
                const li = document.createElement('li');
                li.textContent = text;
                list.appendChild(li);
            });

            $('results').classList.remove('hidden');
            if (track) {
                trackCalculatorUsage('Gratuity Calculator', basicDA);
                $('results').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            initAutoSave('gratuity_calc');
            ['joinDate', 'lastDay', 'basicDA', 'otherPay', 'empType', 'exitReason'].forEach((id) => {
                $(id).addEventListener('input', () => calculate(false));
                $(id).addEventListener('change', () => calculate(false));
            });
            $('calculateBtn').addEventListener('click', () => calculate(true));
            $('resetBtn').addEventListener('click', () => resetForm('gratuity_calc'));
            $('shareBtn').addEventListener('click', () => shareResult('Gratuity', $('payable').textContent));
            calculate(false);
        });
    })();
</script>
{% endblock %}
