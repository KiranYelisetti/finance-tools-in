{% set one = lakhCrore.by['1'] %}
{% set nine8 = lakhCrore.by['9.8'] %}
{% set t270 = lakhCrore.by['270'] %}
{% set h100 = lakhCrore.by['100'] %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How many zeros are in 1 lakh crore?",
      "acceptedAnswer": { "@type": "Answer", "text": "1 lakh crore has {{ one.zeros }} zeros. Written out it is {{ one.indian }} in Indian grouping, or {{ one.international }} in the international system." }
    },
    {
      "@type": "Question",
      "name": "Is 1 lakh crore equal to 1 trillion?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. 1 lakh crore and 1 trillion are the same number, 10 to the power 12. So any figure in lakh crore is the same figure in trillion: 9.8 lakh crore is 9.8 trillion." }
    },
    {
      "@type": "Question",
      "name": "How do you write 9.8 lakh crore in numbers?",
      "acceptedAnswer": { "@type": "Answer", "text": "9.8 lakh crore is {{ nine8.indian }} in Indian grouping, which is {{ nine8.crore }} crore. In the international system it is {{ nine8.international }}, or 9.8 trillion." }
    },
    {
      "@type": "Question",
      "name": "How many crore make 1 lakh crore?",
      "acceptedAnswer": { "@type": "Answer", "text": "1,00,000 crore make 1 lakh crore, the same way 1,00,000 rupees make 1 lakh. To turn lakh crore into crore, multiply by 1,00,000." }
    },
    {
      "@type": "Question",
      "name": "How much is 1 lakh crore in billion?",
      "acceptedAnswer": { "@type": "Answer", "text": "1 lakh crore is {{ one.billion }} billion. Multiply a lakh crore figure by 1,000 to get billions: 270 lakh crore is {{ t270.billion }} billion." }
    }
  ]
}
</script>
