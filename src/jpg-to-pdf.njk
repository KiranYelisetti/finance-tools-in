{% block scripts %}
<script src="/js/vendor/pdf-lib-1.17.1.min.js"></script>
<script src="/js/calc/pdf-tools.js"></script>
<script>
(function () {
    var PT = QTCalc.pdfTools;
    var items = []; // { id, name, size, file, url }
    var nextId = 1;
    var $ = function (id) { return document.getElementById(id); };
    var list = $('imageList'), status = $('pdfStatus'), errors = $('fileErrors');
    var kb = function (n) { return n >= 1048576 ? (n / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(n / 1024)) + ' KB'; };

    function render() {
        list.textContent = '';
        items.forEach(function (it, i) {
            var li = document.createElement('li');
            li.className = 'qt-panel flex items-center gap-3 p-3';
            li.draggable = true;
            li.dataset.index = String(i);
            li.innerHTML = '<span class="qt-row-key w-6 text-center"></span><img alt="" class="w-14 h-14 object-cover rounded-md border border-line shrink-0">' +
                '<span class="min-w-0 flex-1"><span class="block font-semibold break-all"></span><span class="block qt-hint mt-0"></span></span>' +
                '<span class="flex gap-1 shrink-0"></span>';
            li.children[0].textContent = String(i + 1);
            li.children[1].src = it.url;
            li.children[2].children[0].textContent = it.name;
            li.children[2].children[1].textContent = kb(it.size);
            var btns = li.children[3];
            [['up', '↑', 'Move ' + it.name + ' up', i === 0], ['down', '↓', 'Move ' + it.name + ' down', i === items.length - 1], ['remove', '×', 'Remove ' + it.name, false]].forEach(function (b) {
                var el = document.createElement('button');
                el.type = 'button';
                el.className = 'qt-btn qt-btn--secondary qt-btn--sm';
                el.textContent = b[1];
                el.setAttribute('aria-label', b[2]);
                el.disabled = b[3];
                el.dataset.act = b[0];
                btns.appendChild(el);
            });
            list.appendChild(li);
        });
        $('imageCount').textContent = String(items.length);
        $('emptyList').hidden = items.length > 0;
        $('makePdf').disabled = items.length === 0;
        $('clearImages').disabled = items.length === 0;
        if (!items.length) status.textContent = 'Add images to begin.';
        else status.textContent = items.length + (items.length === 1 ? ' image, one page.' : ' images, one page each.');
    }

    function add(files) {
        var bad = [];
        Array.prototype.forEach.call(files, function (f) {
            if (!/^image\//.test(f.type) && !/\.(jpe?g|png|webp|gif|bmp|avif|heic|heif)$/i.test(f.name)) { bad.push(f.name); return; }
            items.push({ id: nextId++, name: f.name, size: f.size, file: f, url: URL.createObjectURL(f) });
        });
        errors.hidden = bad.length === 0;
        errors.textContent = bad.length ? 'Not an image, so left out: ' + bad.join(', ') + '.' : '';
        render();
    }

    list.addEventListener('click', function (ev) {
        var b = ev.target.closest('button[data-act]');
        if (!b) return;
        var i = Number(b.closest('li').dataset.index);
        if (b.dataset.act === 'up') items = PT.move(items, i, i - 1);
        else if (b.dataset.act === 'down') items = PT.move(items, i, i + 1);
        else { URL.revokeObjectURL(items[i].url); items.splice(i, 1); }
        render();
        var again = list.querySelector('li[data-index="' + Math.min(b.dataset.act === 'up' ? i - 1 : b.dataset.act === 'down' ? i + 1 : i, items.length - 1) + '"] button[data-act="' + b.dataset.act + '"]');
        if (again && !again.disabled) again.focus();
    });

    // Drag a row onto another to move it there
    var dragFrom = null;
    list.addEventListener('dragstart', function (ev) { var li = ev.target.closest('li'); if (li) { dragFrom = Number(li.dataset.index); ev.dataTransfer.effectAllowed = 'move'; } });
    list.addEventListener('dragover', function (ev) { if (dragFrom !== null) ev.preventDefault(); });
    list.addEventListener('drop', function (ev) {
        var li = ev.target.closest('li');
        if (dragFrom === null || !li) return;
        ev.preventDefault();
        items = PT.move(items, dragFrom, Number(li.dataset.index));
        dragFrom = null;
        render();
    });
    list.addEventListener('dragend', function () { dragFrom = null; });

    var zone = $('dropZone');
    zone.addEventListener('dragover', function (ev) { if (ev.dataTransfer && Array.prototype.indexOf.call(ev.dataTransfer.types, 'Files') >= 0) ev.preventDefault(); });
    zone.addEventListener('drop', function (ev) { if (ev.dataTransfer && ev.dataTransfer.files.length) { ev.preventDefault(); add(ev.dataTransfer.files); } });
    $('imageInput').addEventListener('change', function (ev) { add(ev.target.files); ev.target.value = ''; });
    $('clearImages').addEventListener('click', function () { items.forEach(function (it) { URL.revokeObjectURL(it.url); }); items = []; errors.hidden = true; render(); });

    /** JPG and PNG go in as they are. Rotated photos and other formats are redrawn upright as JPEG. */
    async function prepare(it) {
        var bytes = new Uint8Array(await it.file.arrayBuffer());
        var type = PT.sniff(bytes);
        if (type === 'png' || (type === 'jpg' && PT.exifOrientation(bytes) === 1)) return { bytes: bytes, type: type };
        var bmp;
        try { bmp = await createImageBitmap(it.file, { imageOrientation: 'from-image' }); }
        catch (e) { throw new Error('This browser cannot open ' + it.name + '. Save it as JPG or PNG and add it again.'); }
        var c = document.createElement('canvas');
        c.width = bmp.width; c.height = bmp.height;
        var ctx = c.getContext('2d');
        ctx.fillStyle = '#ffffff'; // JPEG has no transparency: put see-through parts on white, not black
        ctx.fillRect(0, 0, c.width, c.height);
        ctx.drawImage(bmp, 0, 0);
        var blob = await new Promise(function (res) { c.toBlob(res, 'image/jpeg', 0.92); });
        return { bytes: new Uint8Array(await blob.arrayBuffer()), type: 'jpg' };
    }

    function save(bytes, name) {
        var a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([bytes], { type: 'application/pdf' }));
        a.download = name;
        document.body.appendChild(a);
        a.click();
        setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
    }

    $('makePdf').addEventListener('click', async function () {
        var btn = this;
        btn.disabled = true;
        errors.hidden = true;
        try {
            var ready = [];
            for (var i = 0; i < items.length; i++) {
                status.textContent = 'Reading image ' + (i + 1) + ' of ' + items.length + '...';
                ready.push(await prepare(items[i]));
            }
            var opts = { size: $('pageSize').value, orientation: $('orientation').value, margin: $('margin').value };
            var bytes = await PT.imagesToPdf(PDFLib, ready, opts, function (done, total) { status.textContent = 'Adding page ' + done + ' of ' + total + '...'; });
            save(bytes, items.length === 1 ? items[0].name.replace(/\.[^.]+$/, '') + '.pdf' : 'images.pdf');
            status.textContent = 'Done: ' + ready.length + (ready.length === 1 ? ' page, ' : ' pages, ') + kb(bytes.length) + '. Check your downloads.';
        } catch (e) {
            errors.hidden = false;
            errors.textContent = e && e.message && /cannot open/.test(e.message) ? e.message : 'Something went wrong while making the PDF. Try fewer or smaller images.';
            status.textContent = 'The PDF was not made.';
        } finally {
            btn.disabled = items.length === 0;
        }
    });
    render();
})();
</script>
{% endblock %}
