            <!-- CAGR vs XIRR -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border-2 border-gray-900 dark:border-gray-700 p-8">
                <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">CAGR, XIRR and why your real SIP return looks different</h2>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-4">
                    CAGR (compound annual growth rate) describes one lump sum growing from a starting value to an ending
                    value over a number of years. A SIP is not one lump sum. It is dozens or hundreds of separate
                    purchases on different dates, each with a different holding period. The instalment you paid last month
                    has had four weeks to grow, while the first one has had years.
                </p>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-4">
                    The correct yardstick for such a stream of cash flows is XIRR, the internal rate of return calculated
                    from dated cash flows. Fund statements and most portfolio trackers report XIRR for SIPs. Two habits
                    help when reading your own numbers: do not compare a SIP's absolute return (gain divided by amount
                    invested) with a fund's CAGR, because half your money was invested only recently; and do not expect a
                    10-year SIP to produce the same rupee gain as a lump sum of the same total invested on day one. The
                    smaller gain is the price of spreading the investment over time.
                </p>
            </div>

            <!-- Rupee cost averaging -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border-2 border-gray-900 dark:border-gray-700 p-8">
                <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">Rupee cost averaging, with a worked example</h2>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-4">
                    A SIP buys a fixed rupee amount each month, so it automatically buys more units when the NAV is low
                    and fewer when it is high. Suppose you invest ₹5,000 for four months and the NAV moves from 50 to 40,
                    back to 50, and then to 62.50.
                </p>
                <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-600">
                    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
                        <thead class="bg-gray-50 dark:bg-gray-700">
                            <tr>
                                <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-left text-gray-500 dark:text-gray-300">Month</th>
                                <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-center text-gray-500 dark:text-gray-300">NAV (₹)</th>
                                <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-center text-gray-500 dark:text-gray-300">Invested</th>
                                <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-center text-gray-500 dark:text-gray-300">Units bought</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-600">
                            <tr><td class="px-4 py-3 whitespace-nowrap text-sm font-semibold text-gray-900 dark:text-white">1</td><td class="px-4 py-3 whitespace-nowrap text-sm text-center text-gray-700 dark:text-gray-300">50.00</td><td class="px-4 py-3 whitespace-nowrap text-sm text-center text-gray-700 dark:text-gray-300">₹5,000</td><td class="px-4 py-3 whitespace-nowrap text-sm text-center text-gray-700 dark:text-gray-300">100</td></tr>
                            <tr><td class="px-4 py-3 whitespace-nowrap text-sm font-semibold text-gray-900 dark:text-white">2</td><td class="px-4 py-3 whitespace-nowrap text-sm text-center text-gray-700 dark:text-gray-300">40.00</td><td class="px-4 py-3 whitespace-nowrap text-sm text-center text-gray-700 dark:text-gray-300">₹5,000</td><td class="px-4 py-3 whitespace-nowrap text-sm text-center text-gray-700 dark:text-gray-300">125</td></tr>
                            <tr><td class="px-4 py-3 whitespace-nowrap text-sm font-semibold text-gray-900 dark:text-white">3</td><td class="px-4 py-3 whitespace-nowrap text-sm text-center text-gray-700 dark:text-gray-300">50.00</td><td class="px-4 py-3 whitespace-nowrap text-sm text-center text-gray-700 dark:text-gray-300">₹5,000</td><td class="px-4 py-3 whitespace-nowrap text-sm text-center text-gray-700 dark:text-gray-300">100</td></tr>
                            <tr><td class="px-4 py-3 whitespace-nowrap text-sm font-semibold text-gray-900 dark:text-white">4</td><td class="px-4 py-3 whitespace-nowrap text-sm text-center text-gray-700 dark:text-gray-300">62.50</td><td class="px-4 py-3 whitespace-nowrap text-sm text-center text-gray-700 dark:text-gray-300">₹5,000</td><td class="px-4 py-3 whitespace-nowrap text-sm text-center text-gray-700 dark:text-gray-300">80</td></tr>
                            <tr class="bg-gray-50 dark:bg-gray-700 font-bold"><td class="px-4 py-3 whitespace-nowrap text-sm font-semibold text-gray-900 dark:text-white">Total</td><td class="px-4 py-3 whitespace-nowrap text-sm text-center text-gray-700 dark:text-gray-300"></td><td class="px-4 py-3 whitespace-nowrap text-sm text-center text-gray-700 dark:text-gray-300">₹20,000</td><td class="px-4 py-3 whitespace-nowrap text-sm text-center text-gray-700 dark:text-gray-300">405</td></tr>
                        </tbody>
                    </table>
                </div>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-4 mt-4">
                    You hold 405 units for ₹20,000, an average cost of ₹49.38 per unit, even though the simple average of
                    the four NAVs is ₹50.63. At the final NAV of ₹62.50 the holding is worth ₹25,313. The averaging effect
                    is real, but it has limits: it does not protect you if the NAV keeps falling for years, and in a market
                    that only rises a lump sum invested on day one would have done better.
                </p>
            </div>

            <!-- Step-up SIP -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border-2 border-gray-900 dark:border-gray-700 p-8">
                <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">Step-up SIP: growing the instalment with your income</h2>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-4">
                    A step-up (or top-up) SIP increases the monthly amount by a fixed percentage every year, typically
                    matched to expected salary increments. Start at ₹5,000 a month, raise it by 10% each year, and assume
                    12%: over 10 years you invest ₹9,56,245 and the projected value is ₹16,87,163. A flat ₹5,000 SIP over
                    the same period invests ₹6,00,000 for a projected ₹11,61,695. By the tenth year the stepped-up
                    instalment is ₹11,790 a month.
                </p>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-4">
                    Notice where the extra comes from. The step-up path invests ₹3,56,245 more and ends ₹5,25,468 higher.
                    The advantage is mostly the additional money invested, not any improvement in return, which is exactly
                    why a step-up is useful: it turns future raises into investments before lifestyle spending absorbs them.
                </p>
            </div>

            <!-- SIP vs Lumpsum -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border-2 border-gray-900 dark:border-gray-700 p-8">
                <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">SIP versus lump sum</h2>
                <div class="grid md:grid-cols-2 gap-4">
                    <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
                        <h4 class="font-bold text-indigo-600 dark:text-indigo-400 mb-2">SIP (systematic investment plan)</h4>
                        <ul class="text-sm space-y-2 text-gray-600 dark:text-gray-300 list-disc list-inside">
                            <li>Small, regular amounts, so it fits a monthly salary.</li>
                            <li>Entry is spread across many dates, which reduces the impact of one badly timed purchase.</li>
                            <li>Builds the habit; the mandate runs whether or not the market news is frightening.</li>
                            <li>Late instalments have little time to grow, so the rupee gain trails a lump sum in a rising market.</li>
                        </ul>
                    </div>
                    <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
                        <h4 class="font-bold text-green-600 dark:text-green-400 mb-2">Lump sum (one-time)</h4>
                        <ul class="text-sm space-y-2 text-gray-600 dark:text-gray-300 list-disc list-inside">
                            <li>The full amount works from day one.</li>
                            <li>Outcome depends heavily on what the market does right after you invest.</li>
                            <li>Suited to a bonus, an inheritance or maturity proceeds that are already in hand.</li>
                            <li>A common middle path is to park the money in a liquid fund and move it into equity through a systematic transfer plan (STP).</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Direct vs regular -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border-2 border-gray-900 dark:border-gray-700 p-8">
                <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">Direct plans, regular plans and the expense ratio</h2>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-4">
                    Every open-ended scheme is sold in two plans with the same portfolio and the same fund manager. The
                    regular plan's NAV carries the distributor's commission inside its expense ratio, so the regular NAV
                    grows a little slower than the direct NAV every day. That small daily gap compounds for as long as you
                    stay invested, which over a 15 or 20 year SIP becomes a meaningful difference in the final value.
                    Direct plans have been available since January 2013 and can be bought from the fund house or from
                    platforms that offer them.
                </p>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-4">
                    Which one to choose is a fair trade-off rather than a trick question. If you select funds yourself and
                    do not need advice, a direct plan keeps more of the return. If a distributor helps you choose, rebalance
                    and stay disciplined, you are paying for that service through the regular plan's higher expense ratio.
                    The exact expense ratio of each plan is printed in the scheme's factsheet and on the fund house website.
                </p>
            </div>

            <!-- Risks -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border-2 border-gray-900 dark:border-gray-700 p-8">
                <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">Risks the calculator cannot show</h2>
                <ul class="list-disc list-inside text-gray-600 dark:text-gray-300 leading-relaxed mb-4 space-y-2">
                    <li><strong>Market risk.</strong> The value of equity and debt funds moves with markets and can fall below what you invested. A SIP spreads timing risk; it does not remove it.</li>
                    <li><strong>No guaranteed return.</strong> The rate you enter is your assumption. Nothing in a mutual fund promises it, and past performance does not indicate future results.</li>
                    <li><strong>Category risk.</strong> Small-cap and sector funds swing far more than large-cap or index funds, in both directions.</li>
                    <li><strong>Sequence risk.</strong> A steep fall in the last year or two before you need the money hurts most, because that is when the corpus is largest. Many investors move part of the corpus to debt as the goal date approaches.</li>
                    <li><strong>Costs and liquidity.</strong> Exit loads, the expense ratio and tax all reduce what you actually receive. Read the scheme information document before investing.</li>
                </ul>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    QuickTools India is an educational project and is not a SEBI-registered investment adviser. Nothing on
                    this page is investment advice.
                </p>
            </div>

            <!-- Taxation -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border-2 border-gray-900 dark:border-gray-700 p-8">
                <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">How SIP gains are taxed (as of September 2026)</h2>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-4">
                    Mutual fund gains are capital gains. The rules below follow the changes made by the Finance (No. 2)
                    Act, 2024, which apply to redemptions on or after 23 July 2024. Each SIP instalment is a separate
                    purchase with its own date, and when you redeem, the oldest units are treated as sold first.
                </p>
                <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-600">
                    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
                        <thead class="bg-gray-50 dark:bg-gray-700">
                            <tr>
                                <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-left text-gray-500 dark:text-gray-300">Fund type</th>
                                <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-left text-gray-500 dark:text-gray-300">Holding period</th>
                                <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-left text-gray-500 dark:text-gray-300">Tax</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-600 text-sm text-gray-700 dark:text-gray-300">
                            <tr><td class="px-4 py-3 font-semibold text-gray-900 dark:text-white">Equity-oriented (at least 65% in domestic equity)</td><td class="px-4 py-3">12 months or less</td><td class="px-4 py-3">Short-term capital gains at 20%</td></tr>
                            <tr><td class="px-4 py-3 font-semibold text-gray-900 dark:text-white">Equity-oriented</td><td class="px-4 py-3">More than 12 months</td><td class="px-4 py-3">Long-term capital gains at 12.5% on the amount above ₹1.25 lakh per financial year, no indexation</td></tr>
                            <tr><td class="px-4 py-3 font-semibold text-gray-900 dark:text-white">Debt funds (units bought on or after 1 April 2023)</td><td class="px-4 py-3">Any</td><td class="px-4 py-3">Added to income and taxed at your slab rate</td></tr>
                        </tbody>
                    </table>
                </div>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-4 mt-4">
                    A 4% health and education cess is added to the tax. Example: if your equity long-term gains in a year
                    total ₹3,00,000, the first ₹1,25,000 is exempt, ₹1,75,000 is taxed at 12.5% (₹21,875), and cess adds
                    ₹875, for a total of ₹22,750. A short-term gain of ₹50,000 would cost ₹10,000 plus ₹400 cess. Units
                    bought before 1 February 2018 use the 31 January 2018 price as their cost under the grandfathering
                    rule. Dividend (IDCW) payouts are added to your income and taxed at slab rate. ELSS units are locked
                    in for three years from each instalment. Debt fund units bought before April 2023 follow older rules,
                    so check with a tax professional before redeeming them. Estimate your slab with our
                    <a href="/income-tax-calculator/" class="text-indigo-600 dark:text-indigo-400 hover:underline">income tax calculator</a>.
                </p>
            </div>

            <!-- How to start -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border-2 border-gray-900 dark:border-gray-700 p-8">
                <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">How to start a SIP</h2>
                <ol class="list-decimal list-inside text-gray-600 dark:text-gray-300 leading-relaxed mb-4 space-y-2">
                    <li><strong>Complete KYC once.</strong> You need a PAN and identity and address proof. KYC done with any fund house or registrar is valid across the industry.</li>
                    <li><strong>Match the fund to the goal.</strong> Money needed within three years is usually better placed in debt or liquid funds; longer goals are where equity funds are normally used.</li>
                    <li><strong>Pick direct or regular</strong>, as explained above, and check the scheme's expense ratio and exit load.</li>
                    <li><strong>Set the amount and date</strong> and register a bank mandate (NACH or UPI autopay) so the instalment is debited automatically.</li>
                    <li><strong>Review once a year</strong>, step up the amount when income rises, and avoid stopping during market falls, since those are the months that buy the most units.</li>
                </ol>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-4">
                    New to mutual funds? Read our <a href="/blog/beginners-guide-to-sip-investments/" class="text-indigo-600 dark:text-indigo-400 hover:underline">beginner's guide to SIP investing</a>,
                    or compare with a guaranteed option using the <a href="/ppf-calculator/" class="text-indigo-600 dark:text-indigo-400 hover:underline">PPF calculator</a>.
                </p>
            </div>

            <!-- FAQ Section -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border-2 border-gray-900 dark:border-gray-700 p-8">
                <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-6">Frequently Asked Questions</h2>
                <div class="space-y-4">
                    <details class="group bg-gray-50 dark:bg-gray-700 rounded-lg p-4 cursor-pointer">
                        <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                            What is a good SIP amount to start with?
                            <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                        </summary>
                        <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">Many mutual fund schemes accept a SIP of ₹500 a month, and some accept ₹100. The amount matters less than the number of years you stay invested. A practical approach is to work backwards: enter the amount you need for a goal, the years you have, and an assumed return, then adjust the monthly amount until the projected value matches the goal.</p>
                    </details>
                    <details class="group bg-gray-50 dark:bg-gray-700 rounded-lg p-4 cursor-pointer">
                        <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                            Are SIP returns taxable?
                            <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                        </summary>
                        <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">Yes. As of September 2026, gains on equity mutual fund units held for more than 12 months are long-term capital gains taxed at 12.5% on the portion above ₹1.25 lakh in a financial year, without indexation. Units held for 12 months or less produce short-term gains taxed at 20%. Debt fund units bought on or after 1 April 2023 are taxed at your income tax slab rate whatever the holding period. A 4% health and education cess applies on the tax. Each SIP instalment has its own purchase date, and the oldest units are treated as sold first.</p>
                    </details>
                    <details class="group bg-gray-50 dark:bg-gray-700 rounded-lg p-4 cursor-pointer">
                        <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                            Does the 12% in this calculator mean the fund earns 12% every year?
                            <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                        </summary>
                        <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">No. The calculator converts the annual rate you enter into a monthly rate (12% becomes 1% a month) and applies it to every instalment. Compounding at 1% a month works out to an effective 12.68% a year. Real funds do not deliver the same return every month, so treat the figure as a planning assumption, not a forecast.</p>
                    </details>
                    <details class="group bg-gray-50 dark:bg-gray-700 rounded-lg p-4 cursor-pointer">
                        <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                            What return should I assume for an equity SIP?
                            <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                        </summary>
                        <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">This calculator does not recommend a rate, and no rate is guaranteed. Equity returns vary widely from year to year and across fund categories. A cautious habit is to run three scenarios, for example 8%, 10% and 12%, and to plan around the lowest one so that a weaker decade does not derail the goal.</p>
                    </details>
                    <details class="group bg-gray-50 dark:bg-gray-700 rounded-lg p-4 cursor-pointer">
                        <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                            Can I stop, pause or change my SIP?
                            <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                        </summary>
                        <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">Yes. Most schemes let you pause or stop a SIP without any penalty, because a SIP is just an instruction to invest regularly. The units you already hold stay invested. An exit load may apply if you redeem units within the period stated in the scheme document, and ELSS units are locked in for three years from the date of each instalment.</p>
                    </details>
                    <details class="group bg-gray-50 dark:bg-gray-700 rounded-lg p-4 cursor-pointer">
                        <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                            Is a SIP safe or guaranteed?
                            <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                        </summary>
                        <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">No. A SIP into an equity or debt mutual fund is market-linked, and the value can fall below the amount invested, especially over short periods. Investing regularly spreads your entry points but does not remove market risk. If you need a guaranteed, government-backed return, compare with the Public Provident Fund using our PPF calculator.</p>
                    </details>
                    <details class="group bg-gray-50 dark:bg-gray-700 rounded-lg p-4 cursor-pointer">
                        <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                            How does a step-up SIP change the outcome?
                            <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                        </summary>
                        <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">A step-up SIP raises the monthly amount by a fixed percentage every year, usually in line with salary increases. Starting at ₹5,000 a month with a 10% yearly step-up at an assumed 12% return, you would invest ₹9,56,245 over 10 years for a projected value of ₹16,87,163, against ₹6,00,000 invested and ₹11,61,695 projected for a flat ₹5,000 SIP. Most of the extra value comes from investing more, not from a higher return.</p>
                    </details>
                    <details class="group bg-gray-50 dark:bg-gray-700 rounded-lg p-4 cursor-pointer">
                        <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                            What is the difference between a SIP and a lump sum investment?
                            <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                        </summary>
                        <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">A lump sum puts the whole amount to work on one day, so it benefits fully if the market rises from there and suffers fully if it falls. A SIP spreads the same money across many dates, which lowers the impact of a badly timed entry and suits people investing from a monthly salary. Neither is always better; the outcome depends on how the market moves after you invest.</p>
                    </details>
                </div>
            </div>

            <!-- Financial Disclaimer -->
            <div class="bg-yellow-50 dark:bg-yellow-900 dark:bg-opacity-20 border-l-4 border-yellow-400 p-4 rounded-r-lg">
                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <i class="fas fa-exclamation-triangle text-yellow-400 mt-0.5"></i>
                    </div>
                    <div class="ml-3">
                        <h3 class="text-sm font-medium text-yellow-800 dark:text-yellow-300">Important Disclaimer</h3>
                        <div class="mt-2 text-sm text-yellow-700 dark:text-yellow-200">
                            <p>
                                The calculations on this page are illustrations based on the assumptions you enter and do
                                not constitute financial advice. Mutual fund investments are subject to market risks. Actual
                                returns can differ significantly from projections. Tax rules are stated as of September 2026
                                and can change. Please consult a SEBI-registered investment adviser or a chartered accountant
                                before making investment decisions.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Chart.js CDN (Specific to this page) -->
{% block head %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
{% endblock %}

<script>
    let myChart = null;

    function formatCurrency(amount) {
        if (amount >= 10000000) {
            return '₹' + (amount / 10000000).toFixed(2) + ' Cr';
        } else if (amount >= 100000) {
            return '₹' + (amount / 100000).toFixed(2) + ' Lakh';
        } else {
            return '₹' + amount.toLocaleString('en-IN');
        }
    }

    function calculateSIP() {
        // Get input values
        const p = parseINR(document.getElementById('monthlyInvestment').value);
        const r = parseINR(document.getElementById('returnRate').value);
        const t = parseINR(document.getElementById('timePeriod').value);

        // Calculate
        const i = r / 12 / 100;
        const n = t * 12;

        let fv;
        if (i === 0) {
            fv = p * n;
        } else {
            fv = p * ((Math.pow(1 + i, n) - 1) / i) * (1 + i);
        }
        
        const invested = p * n;
        const returns = fv - invested;

        // GA4 Event Tracking
        trackCalculatorUsage('SIP Calculator', p);

        // Update UI
        document.getElementById('totalValue').innerText = formatCurrency(fv);
        document.getElementById('investedAmount').innerText = formatCurrency(invested);
        document.getElementById('estReturns').innerText = formatCurrency(returns);

        updateChart(invested, returns);
    }

    function updateChart(invested, returns) {
        const ctx = document.getElementById('sipChart').getContext('2d');

        if (myChart) {
            myChart.destroy();
        }

        myChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Invested Amount', 'Est. Returns'],
                datasets: [{
                    data: [invested, returns],
                    backgroundColor: [
                        '#E0E7FF', // Light Indigo
                        '#4F46E5'  // Indigo
                    ],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                let label = context.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                label += formatCurrency(context.raw);
                                return label;
                            }
                        }
                    }
                },
                cutout: '70%'
            }
        });
    }

    // Initialize on load
    document.addEventListener('DOMContentLoaded', () => {
        initAutoSave('sip_calc');
        calculateSIP();
    });
</script>
