{% block scripts %}
<script src="/js/calc/ppf.js"></script>
<script>
    // Input Synchronization
    function syncInput(inputId, sliderId, event) {
        const input = document.getElementById(inputId);
        const slider = document.getElementById(sliderId);

        if (event && event.target === slider) {
            // Slider drives input, format if input is currency-tagged
            input.value = input.classList.contains('format-inr')
                ? formatIndianNumber(slider.value)
                : slider.value;
        } else {
            // Text input drives slider, strip commas before assigning
            slider.value = parseINR(input.value);
        }

        calculatePPF();
    }

    // Format Indian Currency
    function formatIndianCurrency(num) {
        const value = parseFloat(num);
        if (value >= 10000000) {
            return '₹' + (value / 10000000).toFixed(2) + ' Cr';
        } else if (value >= 100000) {
            return '₹' + (value / 100000).toFixed(2) + ' Lac';
        } else {
            return '₹' + value.toLocaleString('en-IN', { maximumFractionDigits: 0 });
        }
    }

    // Load Preset
    function loadPreset(type) {
        const presets = {
            'conservative': { contribution: 50000, years: 15, rate: 7.1 },
            'moderate': { contribution: 100000, years: 15, rate: 7.1 },
            'maximum': { contribution: 150000, years: 15, rate: 7.1 }
        };

        const preset = presets[type];
        document.getElementById('annualContribution').value = formatIndianNumber(preset.contribution);
        document.getElementById('annualContributionSlider').value = preset.contribution;
        document.getElementById('investmentPeriod').value = preset.years;
        document.getElementById('investmentPeriodSlider').value = preset.years;
        document.getElementById('interestRate').value = preset.rate;
        document.getElementById('interestRateSlider').value = preset.rate;

        calculatePPF();
    }

    // Calculate PPF
    function calculatePPF() {
        const annualContribution = parseINR(document.getElementById('annualContribution').value);
        const years = parseInt(document.getElementById('investmentPeriod').value);
        const ratePct = parseINR(document.getElementById('interestRate').value);

        // The sums and the range checks live in /js/calc/ppf.js (unit tested in tests/unit)
        const r = QTCalc.ppf.calculate(annualContribution, years, ratePct);
        if (!r) return;

        // GA4 Event Tracking
        trackCalculatorUsage('PPF Calculator', annualContribution);

        // Display Results
        document.getElementById('maturityValue').textContent = formatIndianCurrency(r.maturityValue);
        document.getElementById('totalContribution').textContent = formatIndianCurrency(r.totalContribution);
        document.getElementById('totalInterest').textContent = formatIndianCurrency(r.totalInterest);
        document.getElementById('taxBenefit').textContent = formatIndianCurrency(r.taxBenefit);
        document.getElementById('taxSavings').textContent = formatIndianCurrency(r.taxSavings).replace('₹', '');
        document.getElementById('partialWithdrawal').textContent = formatIndianCurrency(r.partialWithdrawal);

        // Breakdown
        document.getElementById('breakdown').innerHTML = `
            With an annual contribution of <strong>${formatIndianCurrency(annualContribution)}</strong> for ${years} years
            at <strong>${(r.interestRate * 100).toFixed(1)}%</strong> interest, your PPF account will mature with
            <strong>${formatIndianCurrency(r.maturityValue)}</strong>. This includes
            <strong>${formatIndianCurrency(r.totalInterest)}</strong> in completely tax-free interest earnings.
            You can withdraw up to <strong>${formatIndianCurrency(r.partialWithdrawal)}</strong>
            after 7 years for emergencies or specific needs.
        `;

        // Show results
        document.getElementById('results').classList.remove('hidden');
        document.getElementById('placeholder').classList.add('hidden');
    }

    // Initialize with default values
    window.addEventListener('load', function () {
        initAutoSave('ppf_calc');
        calculatePPF();

        // Add blur change listeners for validation alerts
        document.getElementById('annualContribution').addEventListener('change', (e) => {
            const val = parseINR(e.target.value);
            if (val < 500 || val > 150000) {
                alert('Annual contribution must be between ₹500 and ₹1,50,000');
                e.target.value = formatIndianNumber(Math.min(150000, Math.max(500, val)));
                syncInput('annualContribution', 'annualContributionSlider', null);
            }
        });

        document.getElementById('investmentPeriod').addEventListener('change', (e) => {
            const val = parseInt(e.target.value);
            if (val < 15) {
                alert('PPF minimum period is 15 years');
                e.target.value = 15;
                syncInput('investmentPeriod', 'investmentPeriodSlider', null);
            }
        });
    });
</script>
{% endblock %}
