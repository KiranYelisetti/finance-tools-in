{% block scripts %}
<script src="/js/calc/age.js"></script>
<script>
    // Set today's date on page load
    function setToday() {
        // Local date, not the UTC one (toISOString was a day behind in India before 5:30 am)
        document.getElementById('currentDate').value = QTCalc.age.todayLocal();
    }

    // Initialize with today's date
    window.addEventListener('load', function () {
        setToday();
        initAutoSave('age_calc');
    });

    function calculateAge() {
        const birthDateInput = document.getElementById('birthDate').value;
        const currentDateInput = document.getElementById('currentDate').value;

        // The date sums live in /js/calc/age.js (unit tested in tests/unit)
        const a = QTCalc.age.calculate(birthDateInput, currentDateInput);

        if (a.error === 'missing') {
            alert('Please select both dates');
            return;
        }

        if (a.error === 'future') {
            alert('Birth date cannot be in the future!');
            document.getElementById('results').classList.add('hidden');
            document.getElementById('placeholder').classList.remove('hidden');
            return;
        }

        // Display results
        document.getElementById('years').textContent = a.years;
        document.getElementById('months').textContent = a.months;
        document.getElementById('days').textContent = a.days;

        document.getElementById('totalMonths').textContent = a.totalMonths.toLocaleString('en-IN');
        document.getElementById('totalWeeks').textContent = a.totalWeeks.toLocaleString('en-IN');
        document.getElementById('totalDays').textContent = a.totalDays.toLocaleString('en-IN');
        document.getElementById('totalHours').textContent = a.totalHours.toLocaleString('en-IN');
        document.getElementById('totalMinutes').textContent = a.totalMinutes.toLocaleString('en-IN');

        document.getElementById('ageInWords').textContent = a.text;

        // Next birthday text
        const nextBirthdayText = a.nextBirthday.toLocaleDateString('en-IN', {
            timeZone: 'UTC',
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        }) + ' (' + a.daysUntilBirthday + ' days to go)';
        document.getElementById('nextBirthday').textContent = nextBirthdayText;

        document.getElementById('generation').textContent = a.generation;

        // 10,000th day (or the next round milestone), and the sentence names the same number
        document.getElementById('milestoneDays').textContent = a.milestoneDays.toLocaleString('en-IN') + ' days';
        document.getElementById('tenkDate').textContent = a.milestoneDate.toLocaleDateString('en-IN', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' }) + ' (' + a.milestoneDays.toLocaleString('en-IN') + 'th Day)';

        // Show results, hide placeholder
        document.getElementById('results').classList.remove('hidden');
        document.getElementById('placeholder').classList.add('hidden');
    }
</script>
{% endblock %}
