                        <tr><td class="px-4 py-3 border dark:border-gray-500 font-mono">10,00,00,000</td><td class="px-4 py-3 border dark:border-gray-500">Ten crore</td><td class="px-4 py-3 border dark:border-gray-500 font-mono">100,000,000</td><td class="px-4 py-3 border dark:border-gray-500">One hundred million</td></tr>
                        <tr><td class="px-4 py-3 border dark:border-gray-500 font-mono">1,00,00,00,000</td><td class="px-4 py-3 border dark:border-gray-500">One hundred crore (one arab)</td><td class="px-4 py-3 border dark:border-gray-500 font-mono">1,000,000,000</td><td class="px-4 py-3 border dark:border-gray-500">One billion</td></tr>
