                        <tr><td class="px-4 py-3 border dark:border-gray-500 font-semibold">Billion</td><td class="px-4 py-3 border dark:border-gray-500 font-mono">1,00,00,00,000</td><td class="px-4 py-3 border dark:border-gray-500">9</td><td class="px-4 py-3 border dark:border-gray-500">100 crore, or 1 arab</td></tr>
