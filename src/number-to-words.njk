        </div>

        <!-- Cheque writing -->
        <div class="mt-8 bg-white dark:bg-gray-700 rounded-lg shadow-lg border-2 border-gray-900 dark:border-gray-700 p-8 transition-colors duration-200">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">Writing an Amount in Words on a Cheque</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
                A cheque carries the amount twice: in figures in the box on the right and in words on the line below the payee name. The Cheque Writing Format card above gives you the words line ready to copy. A few conventions make the cheque hard to alter and easy for the bank to read:
            </p>
            <ul class="list-disc list-inside text-gray-600 dark:text-gray-300 space-y-2 mb-6">
                <li><strong>Start with Rupees and end with Only.</strong> Rupees One Lakh Fifty Thousand Only. The word Only stops anyone from adding to the amount, and it is the form banks expect.</li>
                <li><strong>Write paise after the rupees.</strong> Rupees One Thousand Five Hundred and Fifty Paise Only, with 1,500.50 in the figures box. If there are no paise, write Only straight after the rupee words.</li>
                <li><strong>Close the gaps.</strong> Draw a line through any blank space after Only, and write the figures close to the ₹ symbol with /- after them (1,50,000/-) so extra digits cannot be squeezed in.</li>
                <li><strong>Figures and words must agree.</strong> Section 18 of the Negotiable Instruments Act, 1881 says that when they differ, the amount in words is the amount payable. In practice a mismatched cheque is usually returned unpaid, so read both once more before signing.</li>
                <li><strong>No corrections.</strong> Under the RBI's CTS-2010 cheque standards, changes to the payee name or to the amount in figures or words are not accepted, even if you countersign them. Cancel the leaf and write a fresh one.</li>
                <li><strong>Date it right.</strong> A cheque is valid for three months from the date written on it (an RBI instruction in force since 1 April 2012). Write the date in the DD/MM/YYYY boxes printed on the leaf.</li>
            </ul>
            <h3 class="text-xl font-bold text-gray-800 dark:text-white mb-3">Examples</h3>
            <div class="overflow-x-auto mb-4">
                <table class="w-full text-sm border-collapse">
                    <thead class="bg-gray-100 dark:bg-gray-600">
                        <tr>
                            <th class="px-4 py-3 text-left border dark:border-gray-500 text-gray-800 dark:text-gray-200">In figures</th>
                            <th class="px-4 py-3 text-left border dark:border-gray-500 text-gray-800 dark:text-gray-200">On the words line</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-700 dark:text-gray-300 divide-y divide-gray-200 dark:divide-gray-500">
                        <tr><td class="px-4 py-3 border dark:border-gray-500 font-mono">₹500/-</td><td class="px-4 py-3 border dark:border-gray-500">Rupees Five Hundred Only</td></tr>
                        <tr><td class="px-4 py-3 border dark:border-gray-500 font-mono">₹1,250.75</td><td class="px-4 py-3 border dark:border-gray-500">Rupees One Thousand Two Hundred Fifty and Seventy Five Paise Only</td></tr>
                        <tr><td class="px-4 py-3 border dark:border-gray-500 font-mono">₹1,50,000/-</td><td class="px-4 py-3 border dark:border-gray-500">Rupees One Lakh Fifty Thousand Only</td></tr>
                        <tr><td class="px-4 py-3 border dark:border-gray-500 font-mono">₹12,34,567/-</td><td class="px-4 py-3 border dark:border-gray-500">Rupees Twelve Lakh Thirty Four Thousand Five Hundred Sixty Seven Only</td></tr>
                        <tr><td class="px-4 py-3 border dark:border-gray-500 font-mono">₹2,50,00,000/-</td><td class="px-4 py-3 border dark:border-gray-500">Rupees Two Crore Fifty Lakh Only</td></tr>
                    </tbody>
                </table>
            </div>
            <p class="text-gray-600 dark:text-gray-300">
                Our guide on <a href="/blog/how-to-write-cheques-india/" class="text-purple-600 dark:text-purple-400 underline">how to write a cheque in India</a> walks through the whole leaf, including account payee crossing and where to sign.
            </p>
        </div>

        <!-- Invoices -->
        <div class="mt-8 bg-white dark:bg-gray-700 rounded-lg shadow-lg border-2 border-gray-900 dark:border-gray-700 p-8 transition-colors duration-200">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">Amounts in Words on Invoices and GST Bills</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
                Most invoice formats print an Amount in Words line under the total, and accounting software fills it automatically. For Indian customers use the lakh and crore form that matches the figures on the bill: Rupees Twelve Lakh Thirty Four Thousand Only against ₹12,34,000. Export invoices are raised in the currency of the contract, so the words follow that currency and the international scale: US Dollars One Million Five Hundred Thousand Only. Keep one system per document; mixing 15 lakh in one line and 1.5 million in the next invites errors.
            </p>
            <p class="text-gray-600 dark:text-gray-300">
                GST invoices are usually rounded to the nearest rupee (the CGST Act allows tax amounts to be rounded off to the nearest rupee), which means the words end with Only and there are no paise to spell out. Use the <a href="/gst-calculator/" class="text-purple-600 dark:text-purple-400 underline">GST calculator</a> to work out the CGST, SGST or IGST split before you write the total in words, and the <a href="/cash-counter/" class="text-purple-600 dark:text-purple-400 underline">cash counter</a> when the payment arrives in notes.
            </p>
        </div>

        <!-- Common mistakes -->
        <div class="mt-8 bg-white dark:bg-gray-700 rounded-lg shadow-lg border-2 border-gray-900 dark:border-gray-700 p-8 transition-colors duration-200">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">Common Mistakes</h2>
            <ul class="list-disc list-inside text-gray-600 dark:text-gray-300 space-y-2">
                <li><strong>1.5 lakh is not 15 lakh.</strong> 1.5 lakh is 1,50,000; 15 lakh is 15,00,000. Decimal shorthand is fine in conversation, but write the full figure on documents.</li>
                <li><strong>Lakh, not lac.</strong> Both are understood, but lakh is the spelling in RBI and government usage and the one to put on official paperwork.</li>
                <li><strong>1.5 crore is 15 million, not 1.5 million.</strong> 1.5 million is only 15 lakh. Converting between the systems is where most reporting errors creep in, so check the zeros with the table above.</li>
                <li><strong>Hundred and one, or hundred one?</strong> Both forms appear on Indian cheques and both are read the same way. This converter leaves out the and inside the rupee amount and reserves it for the paise, which keeps the words unambiguous.</li>
                <li><strong>Lakh or lakhs?</strong> On the words line the singular is conventional (Fifteen Lakh Rupees), just as you would write Fifteen Thousand and not Fifteen Thousands.</li>
                <li><strong>Forgetting Only.</strong> Without it, a blank space at the end of the line is an invitation to add words.</li>
            </ul>
        </div>

        <!-- Spreadsheets -->
        <div class="mt-8 bg-white dark:bg-gray-700 rounded-lg shadow-lg border-2 border-gray-900 dark:border-gray-700 p-8 transition-colors duration-200">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">Indian Grouping in Excel and Google Sheets</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
                Spreadsheets default to grouping in threes, and neither Excel nor Google Sheets has a built-in number to words function, which is why this page exists. For the commas, a custom number format switches a column to lakh and crore grouping:
            </p>
            <pre class="bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 rounded-lg p-4 text-sm overflow-x-auto mb-4"><code>[&gt;=10000000]##\,##\,##\,##0;[&gt;=100000]##\,##\,##0;##,##0</code></pre>
            <p class="text-gray-600 dark:text-gray-300">
                In Excel, select the cells, open Format Cells, pick Custom and paste the code. In Google Sheets, use Format, then Number, then Custom number format. The three sections handle crores, lakhs and smaller numbers in turn. Setting the Windows regional format to English (India) also makes Excel apply Indian grouping to its standard number formats.
            </p>
        </div>

        <!-- FAQ -->
        <div class="mt-8 bg-white dark:bg-gray-700 rounded-lg shadow-lg border-2 border-gray-900 dark:border-gray-700 p-8 transition-colors duration-200">
            <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-6">Frequently Asked Questions</h2>
            <div class="space-y-4">
                <details class="group bg-gray-50 dark:bg-gray-600 rounded-lg p-4 cursor-pointer">
                    <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                        How many zeros are in a lakh?
                        <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                    </summary>
                    <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">A lakh has 5 zeros. 1 lakh = 1,00,000, which is one hundred thousand in the international system.</p>
                </details>
                <details class="group bg-gray-50 dark:bg-gray-600 rounded-lg p-4 cursor-pointer">
                    <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                        How many lakhs make a crore?
                        <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                    </summary>
                    <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">100 lakhs make 1 crore. 1 crore = 1,00,00,000, which is ten million in the international system.</p>
                </details>
                <details class="group bg-gray-50 dark:bg-gray-600 rounded-lg p-4 cursor-pointer">
                    <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                        How do you write rupees in words on a cheque?
                        <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                    </summary>
                    <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">Start with the word Rupees, spell out the amount, and end with Only. For ₹1,50,000 write Rupees One Lakh Fifty Thousand Only, then draw a line through the leftover space so nothing can be added.</p>
                </details>
                <details class="group bg-gray-50 dark:bg-gray-600 rounded-lg p-4 cursor-pointer">
                    <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                        How do you write paise on a cheque?
                        <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                    </summary>
                    <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">Write the rupee part first, then the word and, then the paise. For ₹1,500.50 write Rupees One Thousand Five Hundred and Fifty Paise Only. If the amount has no paise, write Only straight after the rupee words.</p>
                </details>
                <details class="group bg-gray-50 dark:bg-gray-600 rounded-lg p-4 cursor-pointer">
                    <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                        What happens if the amount in words and figures on a cheque do not match?
                        <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                    </summary>
                    <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">Under Section 18 of the Negotiable Instruments Act, 1881, the amount written in words is the amount ordered to be paid. Many banks simply return such a cheque unpaid, so check both before you sign.</p>
                </details>
                <details class="group bg-gray-50 dark:bg-gray-600 rounded-lg p-4 cursor-pointer">
                    <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                        Is it lakh or lac?
                        <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                    </summary>
                    <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">Both spellings are understood, but lakh is the spelling used by the Reserve Bank of India and government departments. Use lakh on cheques, invoices and official forms.</p>
                </details>
                <details class="group bg-gray-50 dark:bg-gray-600 rounded-lg p-4 cursor-pointer">
                    <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                        How much is 1 million in lakhs, and 1 billion in crores?
                        <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                    </summary>
                    <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">1 million = 10 lakh (10,00,000) and 1 billion = 100 crore (1,00,00,00,000). Going the other way, 1 crore = 10 million and 1 lakh crore = 1 trillion.</p>
                </details>
                <details class="group bg-gray-50 dark:bg-gray-600 rounded-lg p-4 cursor-pointer">
                    <summary class="font-semibold text-gray-800 dark:text-white flex justify-between items-center">
                        What is the difference between the Indian and the international number system?
                        <i class="fas fa-chevron-down text-gray-500 transition-transform group-open:rotate-180"></i>
                    </summary>
                    <p class="mt-3 text-gray-600 dark:text-gray-300 text-sm">The Indian system groups digits as 3, then 2, 2, 2 from the right and uses thousand, lakh and crore (1,00,00,000). The international system groups digits in threes and uses thousand, million and billion (10,000,000). The digits are the same, only the commas and the words change.</p>
                </details>
            </div>
        </div>
    </div>
</main>

{% block scripts %}
<script>
    const ones = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine'];
    const teens = ['Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
    const tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];
    const MAX_RUPEES = 99999999999; // 999,99,99,999 (999 crore)

    function numberToWordsBelow100(num) {
        if (num === 0) return '';
        if (num < 10) return ones[num];
        if (num < 20) return teens[num - 10];
        return tens[Math.floor(num / 10)] + (num % 10 ? ' ' + ones[num % 10] : '');
    }

    function numberToWordsBelow1000(num) {
        if (num === 0) return '';
        if (num < 100) return numberToWordsBelow100(num);
        const hundreds = Math.floor(num / 100);
        const remainder = num % 100;
        return ones[hundreds] + ' Hundred' + (remainder ? ' ' + numberToWordsBelow100(remainder) : '');
    }

    function numberToIndianWords(num) {
        if (num === 0) return 'Zero';

        const crore = Math.floor(num / 10000000);
        const lakh = Math.floor((num % 10000000) / 100000);
        const thousand = Math.floor((num % 100000) / 1000);
        const remainder = num % 1000;

        let words = [];

        if (crore > 0) {
            words.push(numberToIndianWords(crore) + ' Crore');
        }
        if (lakh > 0) {
            words.push(numberToWordsBelow100(lakh) + ' Lakh');
        }
        if (thousand > 0) {
            words.push(numberToWordsBelow1000(thousand) + ' Thousand');
        }
        if (remainder > 0) {
            words.push(numberToWordsBelow1000(remainder));
        }

        return words.join(' ');
    }

    function numberToInternationalWords(num) {
        if (num === 0) return 'Zero';

        const billion = Math.floor(num / 1000000000);
        const million = Math.floor((num % 1000000000) / 1000000);
        const thousand = Math.floor((num % 1000000) / 1000);
        const remainder = num % 1000;

        let words = [];
        if (billion > 0) words.push(numberToWordsBelow1000(billion) + ' Billion');
        if (million > 0) words.push(numberToWordsBelow1000(million) + ' Million');
        if (thousand > 0) words.push(numberToWordsBelow1000(thousand) + ' Thousand');
        if (remainder > 0) words.push(numberToWordsBelow1000(remainder));

        return words.join(' ');
    }

    // "15 Lakh", "1 Crore 23 Lakh 45 Thousand 678"
    function describeIndianNumber(num) {
        if (num === 0) return '0';

        const crore = Math.floor(num / 10000000);
        const lakh = Math.floor((num % 10000000) / 100000);
        const thousand = Math.floor((num % 100000) / 1000);
        const remainder = num % 1000;

        let parts = [];
        if (crore > 0) parts.push(crore + ' Crore');
        if (lakh > 0) parts.push(lakh + ' Lakh');
        if (thousand > 0) parts.push(thousand + ' Thousand');
        if (remainder > 0) parts.push(remainder);

        return parts.join(' ') || '0';
    }

    // "1 Million 500 Thousand"
    function describeInternationalNumber(num) {
        if (num === 0) return '0';

        const billion = Math.floor(num / 1000000000);
        const million = Math.floor((num % 1000000000) / 1000000);
        const thousand = Math.floor((num % 1000000) / 1000);
        const remainder = num % 1000;

        let parts = [];
        if (billion > 0) parts.push(billion + ' Billion');
        if (million > 0) parts.push(million + ' Million');
        if (thousand > 0) parts.push(thousand + ' Thousand');
        if (remainder > 0) parts.push(remainder);

        return parts.join(' ') || '0';
    }

    // 12345678 -> "1,23,45,678" (last three digits, then groups of two)
    function groupIndian(num) {
        const s = String(num);
        if (s.length <= 3) return s;
        const last3 = s.slice(-3);
        let rest = s.slice(0, -3);
        const parts = [];
        while (rest.length > 2) {
            parts.unshift(rest.slice(-2));
            rest = rest.slice(0, -2);
        }
        if (rest) parts.unshift(rest);
        return parts.join(',') + ',' + last3;
    }

    // 12345678 -> "12,345,678"
    function groupInternational(num) {
        return String(num).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    // "50" -> "Five Zero" (used after the word Point in the international reading)
    function digitsInWords(str) {
        const names = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine'];
        return String(str).split('').map(function (d) { return names[parseInt(d, 10)]; }).join(' ');
    }

    // Parses free text like "15,00,000", "1500.50" or "1.999" into whole rupees and paise.
    // Paise are rounded to two digits (half up); a lone trailing dot is ignored.
    function parseAmount(raw) {
        let cleaned = String(raw).replace(/[^0-9.]/g, '');
        const firstDot = cleaned.indexOf('.');
        if (firstDot !== -1) {
            cleaned = cleaned.slice(0, firstDot + 1) + cleaned.slice(firstDot + 1).replace(/\./g, '');
        }
        const dotIndex = cleaned.indexOf('.');
        const intPart = dotIndex === -1 ? cleaned : cleaned.slice(0, dotIndex);
        const fracPart = dotIndex === -1 ? '' : cleaned.slice(dotIndex + 1);

        let rupees = parseInt(intPart, 10) || 0;
        let paise = 0;
        if (fracPart.length > 0) {
            paise = parseInt((fracPart + '00').slice(0, 2), 10);
            if (fracPart.length > 2 && parseInt(fracPart.charAt(2), 10) >= 5) paise += 1;
            if (paise >= 100) {
                rupees += 1;
                paise -= 100;
            }
        }

        // Limit to 999 crores
        let capped = false;
        if (rupees > MAX_RUPEES) {
            rupees = MAX_RUPEES;
            paise = 0;
            capped = true;
        }
        return { rupees: rupees, paise: paise, capped: capped };
    }

    function convertNumber() {
        const inputEl = document.getElementById('numberInput');
        const amount = parseAmount(inputEl.value);
        if (amount.capped) {
            inputEl.value = String(amount.rupees);
        }

        const rupees = amount.rupees;
        const paise = amount.paise;
        const paiseDigits = paise > 0 ? String(paise).padStart(2, '0') : '';
        const rupeeWords = numberToIndianWords(rupees);
        const paiseText = paise > 0 ? ' and ' + numberToWordsBelow100(paise) + ' Paise' : '';

        // Indian Format
        document.getElementById('indianFormat').textContent = describeIndianNumber(rupees);
        document.getElementById('indianGrouped').textContent = '₹' + groupIndian(rupees) + (paise > 0 ? '.' + paiseDigits : '');

        // International Format
        document.getElementById('internationalFormat').textContent = describeInternationalNumber(rupees);
        document.getElementById('internationalGrouped').textContent = groupInternational(rupees) + (paise > 0 ? '.' + paiseDigits : '');

        // In Words
        document.getElementById('inWords').textContent = rupeeWords + ' Rupees' + paiseText + ' Only';

        // Cheque Format
        document.getElementById('chequeFormat').textContent = 'Rupees ' + rupeeWords + paiseText + ' Only';

        // International Words
        document.getElementById('internationalWords').textContent = numberToInternationalWords(rupees) + (paise > 0 ? ' Point ' + digitsInWords(paiseDigits) : '');
    }

    function setExample(num) {
        document.getElementById('numberInput').value = num;
        convertNumber();
    }

    function copyToClipboard(elementId, event) {
        // GA4 Event Tracking
        trackCalculatorUsage('Number to Words', document.getElementById('numberInput').value);

        const text = document.getElementById(elementId).textContent;
        navigator.clipboard.writeText(text).then(() => {
            // Show temporary feedback
            const button = event.target.closest('button');
            const originalHTML = button.innerHTML;
            button.innerHTML = '<i class="fas fa-check"></i>';
            setTimeout(() => {
                button.innerHTML = originalHTML;
            }, 1000);
        });
    }

    // Calculate on page load
    window.addEventListener('load', function () {
        convertNumber();
    });
</script>
{% endblock %}
