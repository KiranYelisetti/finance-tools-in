                        <tr><td class="px-4 py-3 border dark:border-gray-500 font-semibold">Lakh</td><td class="px-4 py-3 border dark:border-gray-500 font-mono">1,00,000</td><td class="px-4 py-3 border dark:border-gray-500">5</td><td class="px-4 py-3 border dark:border-gray-500">100 thousand</td></tr>
                        <tr><td class="px-4 py-3 border dark:border-gray-500 font-semibold">Million</td><td class="px-4 py-3 border dark:border-gray-500 font-mono">10,00,000</td><td class="px-4 py-3 border dark:border-gray-500">6</td><td class="px-4 py-3 border dark:border-gray-500">10 lakh</td></tr>
