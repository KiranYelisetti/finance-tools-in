                        <tr><td class="px-4 py-3 border dark:border-gray-500 font-semibold">Trillion</td><td class="px-4 py-3 border dark:border-gray-500 font-mono">10,00,00,00,00,000</td><td class="px-4 py-3 border dark:border-gray-500">12</td><td class="px-4 py-3 border dark:border-gray-500">1 lakh crore</td></tr>
