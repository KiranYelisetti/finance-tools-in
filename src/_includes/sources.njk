{% if sources %}
<section class="qt-wrap mt-14" aria-labelledby="official-sources">
    <div class="qt-aside max-w-[44rem]">
        <h2 id="official-sources" class="font-serif text-ink text-xl font-semibold mb-1">Where to verify</h2>
        <p class="mb-3">The rules and rates on this page come from these official bodies. Rates and limits change, so check the current figure on the official site before you act on a number here.</p>
        <ul class="space-y-1.5">
            {% for s in sources %}
            <li><a href="{{ s.url }}" target="_blank" rel="noopener" class="qt-link">{{ s.name }}</a> for {{ s.for }}</li>
            {% endfor %}
        </ul>
    </div>
</section>
{% endif %}
