---
layout: base.njk
noIconFont: true
---
{# Guide layout on the Desi Pop components (docs/DESIGN-SYSTEM.md). The first real tag picks the colour. #}
{% set key = "amounts" %}
{% for tag in tags %}{% if tag != "post" and loop.index <= 2 and key == "amounts" %}{% set key = tag | tagKey %}{% endif %}{% endfor %}

<main class="qt-wrap">
    <section class="qt-toolhead max-w-[50rem]">
        <nav class="qt-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog/">Guides</a><span aria-hidden="true">/</span><span class="truncate max-w-[60vw]">{{ title }}</span></nav>
        {% if tags %}
        <div class="flex flex-wrap gap-2.5 mt-5">
            {% for tag in tags %}{% if tag != "post" %}
            <span class="qt-sticker is-{{ tag | tagKey }}" style="--tilt: {{ '-2deg' if loop.index % 2 else '2deg' }}">{{ tag }}</span>
            {% endif %}{% endfor %}
        </div>
        {% endif %}
        <h1 class="qt-h1 mt-5">{{ title }}</h1>
        <div class="flex flex-wrap gap-2 mt-5">
            <span class="qt-stamp">Published <time datetime="{{ page.date | isoDate }}">{{ page.date | humanDate }}</time></span>
            {% if updated %}<span class="qt-stamp">Updated <time datetime="{{ updated | isoDate }}">{{ updated | humanDate }}</time></span>{% endif %}
            {% if readTime %}<span class="qt-stamp">{{ readTime }} min read</span>{% endif %}
        </div>
        <p class="qt-note mt-6 max-w-[44rem]">Educational article. Not financial advice. Please consult a SEBI-registered investment advisor or chartered accountant before acting on any number in this piece.</p>
    </section>

    <article class="qt-prose mt-4">
        {{ content | safe }}
    </article>

    <aside class="qt-card is-{{ key }} qt-section max-w-[50rem]" aria-labelledby="try-tools">
        <span class="qt-sticker is-flat is-ink">Free tools</span>
        <h2 id="try-tools" class="qt-h3 mt-3 mb-2">Work out your own numbers</h2>
        <p class="mb-4">Every calculator here is free, works in Indian formats and runs on your phone, so nothing you type is sent anywhere.</p>
        <div class="qt-chips">
            {% for g in tools %}{% if g.key == key %}{% for t in g.tools %}
            <a class="qt-chip" href="{{ t.url }}">{{ t.name }}</a>
            {% endfor %}{% endif %}{% endfor %}
            <a class="qt-chip is-strong" href="/">All tools</a>
        </div>
    </aside>
</main>
