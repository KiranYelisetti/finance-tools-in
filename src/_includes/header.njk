<header class="qt-header">
    <div class="qt-wrap qt-header-inner">
        <a href="/" class="qt-brand" aria-label="QuickTools India, home">
            <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                <rect x="1" y="1" width="30" height="30" rx="3" fill="#1E5B47"/>
                <path d="M10 9.5H22M10 14H22M13.2 9.5c6.4 0 6.4 8.6 0 8.6H10.6l8.6 6.9" fill="none" stroke="#FFFDF7" stroke-width="2.1" stroke-linecap="square" stroke-linejoin="round"/>
            </svg>
            <span class="qt-brand-name">QuickTools <span>India</span></span>
        </a>

        <nav class="qt-nav" aria-label="Main">
            <div id="toolsDropdown">
                <button type="button" onclick="toggleDropdown()" id="dropdownToggleBtn" aria-haspopup="true" aria-expanded="false" aria-controls="dropdownMenu">
                    Tools
                    <svg class="qt-caret" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
                </button>
            </div>
            <a href="/blog/" {% if page.url and page.url.startsWith('/blog') %}aria-current="page"{% endif %}>Guides</a>
            <a href="/updates/" class="qt-wide-only" {% if page.url == '/updates/' %}aria-current="page"{% endif %}>Updates</a>
        </nav>
    </div>

    <div id="dropdownMenu" class="qt-panel hidden" role="region" aria-label="All tools">
        <div class="qt-wrap qt-panel-grid">
            {% for g in tools %}
            <div>
                <h3>{{ g.group }}</h3>
                {% for t in g.tools %}
                <a href="{{ t.url }}" {% if page.url == t.url %}aria-current="page"{% endif %}>{{ t.name }}</a>
                {% endfor %}
            </div>
            {% endfor %}
        </div>
    </div>
</header>
