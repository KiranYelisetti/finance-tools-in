<!DOCTYPE html>
<html lang="en-IN">

<head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2225082715542003"
         crossorigin="anonymous"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-C3255KS80R"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-C3255KS80R');
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Primary Meta Tags -->
    <title>{{ title | default("QuickTools Plus - Free Online Calculators & Tools") }}</title>
    <meta name="description" content="{{ meta_description | default('Free online calculators for India: Home Loan EMI, SIP, GST, and more.') }}">
    {% if meta_keywords %}
    <meta name="keywords" content="{{ meta_keywords }}">
    {% endif %}
    <meta name="author" content="QuickTools Plus">
    <meta name="robots" content="{{ robots | default("index, follow") }}">
    <link rel="canonical" href="https://www.quicktoolsplus.com{{ page.url | replace('.html', '/') }}">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://www.quicktoolsplus.com{{ page.url }}">
    <meta property="og:title" content="{{ meta_title | default(title) }}">
    <meta property="og:description" content="{{ meta_description | default('Free online calculators for India: Home Loan EMI, SIP, GST, and more.') }}">
    <meta property="og:image" content="https://www.quicktoolsplus.com/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ meta_title | default(title) }}">
    <meta property="og:site_name" content="QuickTools Plus">
    <meta property="og:locale" content="en_IN">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://www.quicktoolsplus.com{{ page.url }}">
    <meta name="twitter:title" content="{{ meta_title | default(title) }}">
    <meta name="twitter:description" content="{{ meta_description | default('Free online calculators for India: Home Loan EMI, SIP, GST, and more.') }}">
    <meta name="twitter:image" content="https://www.quicktoolsplus.com/og-image.png">
    <meta name="twitter:image:alt" content="{{ meta_title | default(title) }}">

    <!-- Additional SEO -->
    <meta name="theme-color" content="#FBF3E4" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#13100D" media="(prefers-color-scheme: dark)">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <!-- Theme before first paint: saved choice, else the device setting. Adds .js so reveals only hide content when JS runs. -->
    <script>
        (function () {
            var d = document.documentElement; d.classList.add('js');
            try {
                var t = localStorage.getItem('qt-theme');
                if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) d.classList.add('dark');
            } catch (e) {}
        })();
    </script>

    <!-- Design system build (src/css/ds, docs/DESIGN-SYSTEM.md) -->
    <link rel="preload" href="/fonts/bricolage-grotesque-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/styles.css">
    {% if not noIconFont %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    {% endif %}

    {% if json_ld %}
    <script type="application/ld+json">
    {{ json_ld | dump | safe }}
    </script>
    {% endif %}

    {% block head %}{% endblock %}
</head>

<body class="qt min-h-screen font-sans">
    {% include "header.njk" %}

    {{ content | safe }}

    {% include "sources.njk" %}

    {% include "footer.njk" %}

    <script src="/js/main.js"></script>
    <script src="/js/ui.js"></script>

    {% block scripts %}{% endblock %}
</body>
</html>
