<footer class="qt-footer">
    <div class="qt-wrap">
        <div class="grid gap-9 sm:grid-cols-2 lg:grid-cols-4">
            <div>
                <span class="qt-sticker is-haldi">Free, no sign-up</span>
                <p class="mt-4 mb-3 text-chai-200">Calculators for Indian money. Every tool runs in your browser, and nothing you type is sent anywhere.</p>
                <p>Found a wrong figure or want a tool?<br><a href="mailto:quicktoolsindiaa@gmail.com" class="font-bold underline underline-offset-4">quicktoolsindiaa@gmail.com</a></p>
            </div>
            {% for g in tools %}{% if loop.index <= 2 %}
            <div>
                <h2>{{ g.group }}</h2>
                <ul class="space-y-1.5">
                    {% for t in g.tools %}<li><a href="{{ t.url }}">{{ t.name }}</a></li>{% endfor %}
                </ul>
            </div>
            {% endif %}{% endfor %}
            <div>
                <h2>More tools</h2>
                <ul class="space-y-1.5">
                    {% for g in tools %}{% if loop.index > 2 %}{% for t in g.tools %}<li><a href="{{ t.url }}">{{ t.name }}</a></li>{% endfor %}{% endif %}{% endfor %}
                </ul>
            </div>
        </div>

        <div class="mt-11 pt-6 border-t-2 border-chai-800 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between text-sm">
            <p>&copy; 2026 QuickTools India. For information only, not financial advice.</p>
            <ul class="flex flex-wrap gap-x-5 gap-y-1.5">
                <li><a href="/about/">About</a></li>
                <li><a href="/blog/">Guides</a></li>
                <li><a href="/updates/">Updates</a></li>
                <li><a href="/contact/">Contact</a></li>
                <li><a href="/privacy-policy/">Privacy</a></li>
                <li><a href="/terms-of-service/">Terms</a></li>
                <li><a href="/disclaimer/">Disclaimer</a></li>
            </ul>
        </div>
    </div>
    <span class="qt-footer-word" aria-hidden="true">QuickTools</span>
</footer>

<div class="qt-toast" id="qtToast" role="status" aria-live="polite"></div>

<script>
    // Tools menu
    function toggleDropdown() {
        const menu = document.getElementById('dropdownMenu');
        const btn = document.getElementById('dropdownToggleBtn');
        const isHidden = menu.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', String(!isHidden));
    }

    function closeDropdown() {
        document.getElementById('dropdownMenu').classList.add('hidden');
        document.getElementById('dropdownToggleBtn')?.setAttribute('aria-expanded', 'false');
    }

    // Close on outside click
    document.addEventListener('click', function (event) {
        const dropdown = document.getElementById('toolsDropdown');
        const menu = document.getElementById('dropdownMenu');
        if (dropdown && !dropdown.contains(event.target) && menu && !menu.contains(event.target)) closeDropdown();
    });

    // Close on ESC key
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeDropdown();
    });
</script>
